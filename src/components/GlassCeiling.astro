---
// Glass ceiling as a scroll story (no card): the section pins while you scroll,
// a full-width chart draws on the page background, and one short line of copy swaps per beat:
//  1. "The things that get you to your first milestone…" → grey line rises
//  2. "Then it stalled."                   → line flattens under the dashed glass ceiling, blockers pop up
//  3. "The ceiling is the missing system." → orange line breaks through
// Hitting the ceiling is physical: at the end of beat 2 the scroll turns heavy (you have to push),
// each push cracks the glass a little more with a thud, then it shatters and the orange line goes through.
const steps = [
  // Tom's Loom review (brief/05): replaces "You grew on talent."
  { t: "The things that get you from your first milestone <em class='accent'>won't get you past the next one.</em>", s: "Great content, a strong network, sheer graft and a bit of luck.", long: true },
  { t: "Then it <em class='accent'>stalled.</em>", s: "Reach plateaus. Every launch depends on how hard you push that month.", hint: "Keep scrolling to break through" },
  { t: "The ceiling is the <em class='accent'>missing system.</em>", s: "Not your audience. Not your expertise." },
];
// Glass breaks where the orange breakout crosses the ceiling (authored 1200x420 grid)
const IMPACT = { x: 670, y: 186 };
const cracks = [
  ["M670 186 L640 178 L612 182 L590 172", "M670 186 L702 192 L728 186"],
  ["M670 186 L662 160 L668 138 L656 118", "M670 186 L690 166 L716 158 L740 140", "M612 182 L596 198"],
  ["M670 186 L650 206 L640 228", "M670 186 L696 210 L704 232", "M728 186 L760 180 L790 188 L820 182", "M590 172 L560 176 L530 168"],
];
const shards = [
  { d: "M664 180 L676 174 L678 188 Z", x: -40, y: -70, r: -140 },
  { d: "M680 182 L692 178 L688 192 Z", x: 50, y: -80, r: 160 },
  { d: "M652 184 L664 186 L656 194 Z", x: -70, y: -30, r: -90 },
  { d: "M690 186 L702 184 L698 196 Z", x: 80, y: -40, r: 120 },
  { d: "M668 188 L676 192 L666 198 Z", x: -20, y: 60, r: 200 },
  { d: "M676 172 L684 166 L688 176 Z", x: 20, y: -110, r: -220 },
  { d: "M644 178 L652 174 L654 182 Z", x: -100, y: -60, r: 80 },
  { d: "M700 178 L708 174 L712 184 Z", x: 110, y: -70, r: -60 },
];
// Things people say at this stage (Tom's review added the last three). x/y = % of the content-width chart layer.
const blockers = [
  { q: "I've got an audience but no idea about ads.", x: 30, y: 13 },
  { q: "I don't know how to build a funnel.", x: 66, y: 13 },
  { q: "I've never run a proper webinar.", x: 46, y: 29 },
  { q: "I want to get myself out of the day-to-day running of this business.", x: 40, y: 60 },
  { q: "I want to scale to 7 or 8 figures.", x: 82, y: 29 },
  { q: "My organic social metrics have slowed down.", x: 74, y: 60 },
];
---
<section id="glass-ceiling" class="gc relative" aria-label="The glass ceiling">
  <div class="gc-pin">
    <div class="gc-inner mx-auto w-full max-w-[1240px] px-5">

      <div class="gc-copy" aria-live="polite">
        {steps.map((st, i) => (
          <div class="step" data-i={i}>
            <h2 class={`${st.long ? "mx-auto max-w-[980px] text-[clamp(28px,3.9vw,56px)] leading-[1.06]" : "text-[clamp(34px,5.2vw,76px)] leading-[1.02]"} font-semibold tracking-[-0.04em] text-text`} set:html={st.t} />
            <p class="mx-auto mt-4 max-w-[520px] text-[clamp(15px,1.4vw,18px)] text-text-2">{st.s}</p>
            {st.hint && <p class="push-hint">{st.hint} <span aria-hidden="true">↓</span></p>}
          </div>
        ))}
      </div>

      <div class="gc-chart">
        <!-- Curves are C1-continuous: the grey S-curve flattens to a horizontal tangent at x=560,
             and the orange breakout leaves from that same point with the same tangent, so the fork has no kink.
             Shapes are authored on a 1200x420 grid (data-d) and rescaled to the real pixel size by the script,
             so strokes never stretch and the line-draw / tip maths stay exact. -->
        <svg viewBox="0 0 1200 420" preserveAspectRatio="none" class="h-full w-full" aria-hidden="true">
          <defs>
            <linearGradient id="gc-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="var(--accent)" stop-opacity=".28" />
              <stop offset=".5" stop-color="var(--accent)" stop-opacity=".08" />
              <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="gc-fade-x" x1=".467" y1="0" x2=".717" y2="0">
              <stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset="1" stop-color="#fff" stop-opacity="1" />
            </linearGradient>
            <!-- Breakout line starts in the grey of the stalled line and warms into orange; its glow fades in from nothing -->
            <linearGradient id="gc-line" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="var(--text)" stop-opacity=".3" />
              <stop offset=".38" stop-color="var(--accent)" stop-opacity="1" />
            </linearGradient>
            <linearGradient id="gc-halo" x1="0" y1="0" x2="1" y2="0">
              <stop offset=".08" stop-color="var(--accent)" stop-opacity="0" />
              <stop offset=".5" stop-color="var(--accent)" stop-opacity="1" />
            </linearGradient>
            <mask id="gc-mask"><rect width="100%" height="100%" fill="url(#gc-fade-x)" /></mask>
            <filter id="gc-glow" x="-20%" y="-50%" width="140%" height="200%">
              <feGaussianBlur stdDeviation="6" />
            </filter>
          </defs>
          <!-- Ceiling in two halves so it can split open at the impact point -->
          <path class="ceil ceil-l" data-d={`M0 186 L${IMPACT.x} 186`} d={`M0 186 L${IMPACT.x} 186`} />
          <path class="ceil ceil-r" data-d={`M${IMPACT.x} 186 L1200 186`} d={`M${IMPACT.x} 186 L1200 186`} />
          {cracks.map((group, s) => (
            <g class="cracks" data-s={s + 1}>
              {group.map((d) => <path class="crack" pathLength="1" data-d={d} d={d} />)}
            </g>
          ))}
          {shards.map((sh) => (
            <path class="shard" data-d={sh.d} d={sh.d} style={`--x:${sh.x}px;--y:${sh.y}px;--r:${sh.r}deg`} />
          ))}
          <path class="grey" pathLength="1" data-d="M0 400 C180 400 300 340 400 276 S500 196 560 196 C760 196 980 198 1200 196" d="M0 400 C180 400 300 340 400 276 S500 196 560 196 C760 196 980 198 1200 196" />
          <path class="area" mask="url(#gc-mask)" data-d="M560 196 C660 196 720 170 800 130 S1000 44 1200 28 L1200 420 L560 420 Z" d="M560 196 C660 196 720 170 800 130 S1000 44 1200 28 L1200 420 L560 420 Z" />
          <path class="orange halo" pathLength="1" filter="url(#gc-glow)" data-d="M560 196 C660 196 720 170 800 130 S1000 44 1200 28" d="M560 196 C660 196 720 170 800 130 S1000 44 1200 28" />
          <path class="orange" pathLength="1" data-d="M560 196 C660 196 720 170 800 130 S1000 44 1200 28" d="M560 196 C660 196 720 170 800 130 S1000 44 1200 28" />
        </svg>
        <span class="tip" aria-hidden="true"></span>
        <span class="pressure" style={`left:${(IMPACT.x / 1200) * 100}%;top:${(IMPACT.y / 420) * 100}%`} aria-hidden="true"></span>
        <!-- Label + blockers live in a content-width layer so they line up with the copy on any screen width -->
        <div class="b-layer">
          <span class="ceil-label">Glass ceiling</span>
          <p class="quotes-cap">Here are some examples of things we hear from people at this stage.</p>
          {blockers.map((b, i) => (
            <span class="blocker" data-b={i} style={`left:${b.x}%;top:${b.y}%`}>“{b.q}”</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .gc { height: 600vh; }
  .gc-pin { position: sticky; top: 0; height: 100svh; display: flex; align-items: center; overflow: hidden; }
  .gc-inner { position: relative; height: 100%; display: grid; grid-template-rows: auto 1fr;
    /* header sits at the same height as the Growth System header; the script sets --gc-top from it */
    padding-top: var(--gc-top, 160px); padding-bottom: 6vh; }


  .gc-copy { position: relative; min-height: clamp(150px, 15vw, 210px); }
  .step { position: absolute; inset: 0 0 auto 0; text-align: center; opacity: 0; transform: translateY(14px); transition: opacity .5s var(--ease-out-soft), transform .5s var(--ease-out-soft); }
  .step.on { opacity: 1; transform: none; }

  /* Full-bleed chart: runs edge to edge of the viewport and fades out at both sides, so no line ever stops at a hard edge */
  .gc-chart { position: relative; margin-top: 2vh; min-height: 220px; width: 100vw; margin-left: calc(50% - 50vw); }
  .gc-chart svg {
    overflow: visible;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 12%, #000 88%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 12%, #000 88%, transparent 100%);
  }
  svg .ceil { fill: none; stroke: color-mix(in srgb, var(--text) 32%, transparent); stroke-width: 1; stroke-dasharray: 6 8; opacity: 0; transition: opacity .6s, transform .7s var(--ease-out-soft); }
  /* On impact the two halves spring apart and sag a touch */
  .gc.broken svg .ceil-l { transform: translate(-14px, 3px); }
  .gc.broken svg .ceil-r { transform: translate(14px, 3px); }

  /* Cracks: each push snaps one more group of fracture lines out from the impact point */
  svg .crack { fill: none; stroke: rgb(255 236 220 / .85); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1 2; stroke-dashoffset: 1; transition: stroke-dashoffset .35s var(--ease-out-soft), opacity .6s; }
  svg .cracks.on .crack { stroke-dashoffset: 0; }
  .gc.broken svg .crack { opacity: .25; }

  /* Shards: invisible glass until it breaks, then they fly out and fade */
  svg .shard { fill: rgb(255 240 228 / .9); stroke: rgb(255 115 55 / .6); stroke-width: .6; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .gc.broken svg .shard { animation: shard 1.1s cubic-bezier(.2, .7, .3, 1) forwards; }
  @keyframes shard {
    0% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translate(var(--x), var(--y)) rotate(var(--r)) scale(.6); }
  }

  /* Pressure: an orange glow building at the impact point while you push */
  .pressure {
    position: absolute; width: 220px; height: 120px; margin: -60px 0 0 -110px; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgb(255 170 100 / .7), rgb(255 61 0 / .35) 45%, transparent);
    filter: blur(10px); opacity: 0; transform: scale(.5);
  }
  .gc.broken .pressure { transition: opacity .8s, transform .8s var(--ease-out-soft); opacity: 0 !important; transform: scale(1.8) !important; }

  /* Thud: a short jolt each time a new crack appears */
  .gc-chart.thud { animation: thud .32s cubic-bezier(.3, .7, .4, 1); }
  @keyframes thud {
    0% { transform: translateY(0); } 25% { transform: translateY(-5px); } 50% { transform: translateY(3px); }
    75% { transform: translateY(-1.5px); } 100% { transform: translateY(0); }
  }

  .push-hint {
    margin-top: 14px; font-size: 13px; font-weight: 600; color: var(--accent);
    opacity: 0; transform: translateY(6px); transition: opacity .4s, transform .4s var(--ease-out-soft);
  }
  .push-hint span { display: inline-block; animation: nudge 1.2s ease-in-out infinite; }
  @keyframes nudge { 50% { transform: translateY(3px); } }
  .gc.pushing .push-hint { opacity: 1; transform: none; }
  /* dash 1 / gap 2 so the round cap of the next dash never peeks in at the path end */
  svg .grey, svg .orange { fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1 2; stroke-dashoffset: 1; }
  svg .grey { stroke: color-mix(in srgb, var(--text) 38%, transparent); stroke-width: 2.5; }
  svg .orange { stroke: url(#gc-line); stroke-width: 3.5; }
  svg .orange.halo { stroke: url(#gc-halo); stroke-width: 10; opacity: .55; }
  svg .area { fill: url(#gc-fill); opacity: 0; }

  /* Glowing dot riding the head of the orange line while it draws */
  .tip {
    position: absolute; left: 0; top: 0; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 45%, transparent), 0 0 24px 6px var(--accent);
    opacity: 0; transition: opacity .3s;
  }

  .b-layer { position: absolute; inset: 0; margin: 0 auto; max-width: 1240px; pointer-events: none; }
  .ceil-label {
    position: absolute; left: 20px; top: calc(186 / 420 * 100%); transform: translateY(-160%);
    font-size: 13px; font-weight: 600; color: var(--text-2); opacity: 0; transition: opacity .6s;
  }
  /* Lead-in line for the quotes; fades in and out with them */
  .quotes-cap {
    position: absolute; left: 50%; top: 0; transform: translate(-50%, 6px); margin: 0; width: max-content; max-width: calc(100% - 40px);
    text-align: center; font-size: clamp(12px, 1vw, 14px); color: var(--muted); opacity: 0;
    transition: opacity .6s var(--ease-out-soft), transform .6s var(--ease-out-soft);
  }
  .quotes-cap.on { opacity: 1; transform: translate(-50%, 0); }
  .blocker {
    position: absolute; transform: translate(-50%, 8px) scale(.96); opacity: 0;
    font-size: clamp(12px, 1.1vw, 15px); color: var(--text-2); white-space: nowrap;
    padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 75%, transparent); backdrop-filter: blur(6px);
    transition: opacity .6s var(--ease-out-soft), transform .6s var(--ease-out-soft);
  }
  .blocker.on { opacity: 1; transform: translate(-50%, 0) scale(1); }
  .blocker.gone { opacity: 0; transform: translate(-50%, -8px) scale(.96); }

  @media (max-width: 767px) {
    .gc { height: 540vh; }
    .gc-inner { padding-top: 96px; }
    .blocker { white-space: normal; width: 168px; text-align: center; font-size: 12px; padding: 8px 12px; }
    /* caption sits just above the chart; quotes zig-zag and leave the ceiling line (~45%) clear */
    .quotes-cap { top: -10px; transform: translate(-50%, calc(-100% + 6px)); }
    .quotes-cap.on { transform: translate(-50%, -100%); }
    .blocker[data-b="0"] { left: 30% !important; top: 3% !important; }
    .blocker[data-b="1"] { left: 70% !important; top: 15% !important; }
    .blocker[data-b="2"] { left: 30% !important; top: 27% !important; }
    .blocker[data-b="3"] { left: 70% !important; top: 51% !important; }
    .blocker[data-b="4"] { left: 30% !important; top: 67% !important; }
    .blocker[data-b="5"] { left: 70% !important; top: 81% !important; }
  }

  /* Reduced motion: no pinning; show the final state */
  @media (prefers-reduced-motion: reduce) {
    .gc { height: auto; } .gc-pin { position: relative; height: auto; padding: 80px 0; }
    .gc-inner { height: auto; } .gc-chart { height: 300px; }
    .step[data-i="2"] { opacity: 1; transform: none; position: relative; }
    svg .grey, svg .orange { stroke-dashoffset: 0; } svg .area, svg .ceil, .ceil-label { opacity: 1; }
    .push-hint, .pressure { display: none; }
  }
</style>

<script>
  const sec = document.getElementById("glass-ceiling")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const steps = [...sec.querySelectorAll<HTMLElement>(".step")];
  const blockers = [...sec.querySelectorAll<HTMLElement>(".blocker")];
  const grey = sec.querySelector<SVGPathElement>(".grey")!;
  const oranges = [...sec.querySelectorAll<SVGPathElement>(".orange")];
  const orange = oranges[oranges.length - 1];
  const tip = sec.querySelector<HTMLElement>(".tip")!;
  const area = sec.querySelector<SVGPathElement>(".area")!;
  const ceils = [...sec.querySelectorAll<SVGPathElement>(".ceil")];
  const crackGroups = [...sec.querySelectorAll<SVGGElement>(".cracks")];
  const pressure = sec.querySelector<HTMLElement>(".pressure")!;
  const chart = sec.querySelector<HTMLElement>(".gc-chart")!;
  let stage = 0; // how many crack groups are showing
  let heavy = false; // scroll resistance on?
  const ceilLabel = sec.querySelector<HTMLElement>(".ceil-label")!;
  const quotesCap = sec.querySelector<HTMLElement>(".quotes-cap")!;
  const svg = sec.querySelector<SVGSVGElement>(".gc-chart svg")!;
  const shapes = [...svg.querySelectorAll<SVGPathElement>("[data-d]")];
  const clamp = (v: number) => Math.max(0, Math.min(1, v));
  const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
  let orangeLen = 0;

  // Scroll resistance via Lenis (wheel / trackpad). Touch scrolling is native, so phones get the visuals only.
  function setHeavy(on: boolean) {
    if (on === heavy) return;
    heavy = on;
    const vs = (window as any).lenis?.virtualScroll;
    if (vs) vs.options.wheelMultiplier = on ? 0.4 : 1;
  }

  // Rescale the 1200x420 authored shapes to the chart's real pixel size (coordinates are x,y pairs)
  function layout() {
    const w = svg.clientWidth, h = svg.clientHeight;
    if (!w || !h) return;
    svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
    shapes.forEach((el) => {
      let i = 0;
      el.setAttribute("d", el.dataset.d!.replace(/-?\d+(\.\d+)?/g, (n) => ((i++ % 2 ? (+n * h) / 420 : (+n * w) / 1200).toFixed(1))));
    });
    orangeLen = orange.getTotalLength();
  }

  function render() {
    const r = sec.getBoundingClientRect();
    const total = sec.offsetHeight - window.innerHeight;
    const p = clamp(-r.top / total); // 0 → 1 across the pinned scroll

    // Each beat animates early in its slice, then holds so the copy can be read before the next one
    const beat = p < 0.26 ? 0 : p < 0.66 ? 1 : 2;
    steps.forEach((s, i) => s.classList.toggle("on", i === beat));

    grey.style.strokeDashoffset = String(1 - seg(p, 0.03, 0.42));
    const ceilOn = p > 0.28;
    ceilLabel.style.opacity = ceilOn ? "1" : "0";
    // Blockers arrive one at a time with room to read each, then all stay until the ceiling breaks
    quotesCap.classList.toggle("on", p > 0.29 && p < 0.66);
    blockers.forEach((b, i) => {
      const show = p > 0.31 + i * 0.03;
      b.classList.toggle("on", show && p < 0.66);
      b.classList.toggle("gone", p >= 0.66);
    });

    // Hitting the ceiling (p .50 → .66): scroll turns heavy, pressure builds, the glass cracks in 3 thuds
    const pinned = r.top <= 0 && r.bottom >= innerHeight;
    const push = seg(p, 0.5, 0.66);
    const pushing = pinned && p >= 0.48 && p < 0.66;
    const broken = p >= 0.66;
    sec.classList.toggle("pushing", pushing);
    sec.classList.toggle("broken", broken);
    setHeavy(pushing);
    ceils.forEach((c) => {
      c.style.opacity = ceilOn ? "1" : "0";
      c.style.stroke = `color-mix(in srgb, var(--accent) ${Math.round(push * 85)}%, color-mix(in srgb, var(--text) 32%, transparent))`;
      c.style.strokeWidth = String(1 + push * 1.2);
    });
    if (!broken) {
      pressure.style.opacity = String(push * 0.9);
      pressure.style.transform = `scale(${0.5 + push * 0.7})`;
    }
    const next = push >= 0.85 ? 3 : push >= 0.55 ? 2 : push >= 0.22 ? 1 : 0;
    if (next > stage) { chart.classList.remove("thud"); void chart.offsetWidth; chart.classList.add("thud"); }
    stage = next;
    crackGroups.forEach((g, i) => g.classList.toggle("on", broken || i < stage));
    const draw = seg(p, 0.67, 0.88);
    oranges.forEach((o) => {
      o.style.strokeDashoffset = String(1 - draw);
      o.style.visibility = draw > 0.001 ? "" : "hidden"; // no stray round cap at the fork before the breakout
    });
    const pt = orange.getPointAtLength(orangeLen * draw);
    tip.style.transform = `translate(${pt.x}px, ${pt.y}px)`;
    // Dot fades with the chart's right-edge fade, so it never sits half-cut at the screen edge
    tip.style.opacity = draw > 0.01 ? String(clamp((1 - pt.x / svg.clientWidth) / 0.14) * clamp(draw / 0.2)) : "0";
    area.style.opacity = String(seg(p, 0.72, 0.94));
    grey.style.opacity = String(1 - 0.6 * seg(p, 0.67, 0.8));
  }

  // Put this headline at the same height as the Growth System headline (that one is vertically centred,
  // so its position depends on screen size). Mobile keeps its own CSS padding since neither pins there.
  const gsPin = document.querySelector<HTMLElement>("#growth-system .gs-pin");
  const gsLabel = document.querySelector<HTMLElement>("#growth-system h2");
  function syncTop() {
    if (!gsPin || !gsLabel || reduce || matchMedia("(max-width: 899px)").matches) return sec.style.removeProperty("--gc-top");
    sec.style.setProperty("--gc-top", `${Math.round(gsLabel.getBoundingClientRect().top - gsPin.getBoundingClientRect().top)}px`);
  }
  syncTop();
  if (gsPin) new ResizeObserver(syncTop).observe(gsPin);

  layout();
  new ResizeObserver(() => { layout(); if (!reduce) render(); }).observe(svg);
  if (!reduce) {
    render();
    window.addEventListener("scroll", render, { passive: true });
  }
</script>
