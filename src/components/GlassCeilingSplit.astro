---
// Glass ceiling, split variant (the mockup layout Tom reviewed): copy on the left, the chart in a panel on the right.
// Kept beside the full-width GlassCeiling for comparison; keep one of the two.
// Same scroll story and effects as GlassCeiling: the section pins, the grey line draws, the glass ceiling appears
// and the quotes pop in, then the scroll turns heavy, each push cracks the glass, it shatters and the orange line
// breaks through. The paragraph for the current beat lights up; the others dim.
// Copy: brief/04-copy-deck.md 3A with Tom's Loom changes (new headline, no "talent" framing, quotes lead-in, six quotes).
// Phones: no pin; everything stacks and the chart plays its story as it scrolls through the screen.
const paras = [
  "You can only go so far with great content, a strong network, a good product, sheer graft and maybe a bit of luck.",
  "Then growth stalls. Reach plateaus, every launch depends on how hard you push that month, and revenue rises and falls with your content.",
  "The ceiling isn't your audience or your expertise. It's the missing system.",
];
const quotes = [
  "I've got an audience but no idea about ads.",
  "I don't know how to build a funnel.",
  "I've never run a proper webinar.",
  "I want to get myself out of the day-to-day running of this business.",
  "I want to scale to 7 or 8 figures.",
  "My organic social metrics have slowed down.",
];
// Chart authored on a 600x340 grid; the panel keeps that aspect ratio so nothing stretches.
const IMPACT = { x: 370, y: 165 };
const axis = [
  { t: "$1M/mo", y: 34 },
  { t: "$100K/mo", y: 122 },
  { t: "$80K/mo", y: 165 },
  { t: "$0", y: 290 },
];
const cracks = [
  ["M370 165 L354 160 L340 163 L328 157", "M370 165 L386 169 L400 165"],
  ["M370 165 L366 151 L369 139 L363 128", "M370 165 L380 154 L394 150 L406 140", "M340 163 L332 172"],
  ["M370 165 L359 176 L354 188", "M370 165 L384 178 L388 190", "M400 165 L416 161 L432 166 L446 162", "M328 157 L312 160 L296 155"],
];
const shards = [
  { d: "M366 161 L373 157 L374 165 Z", x: -22, y: -40, r: -140 },
  { d: "M375 162 L382 160 L380 168 Z", x: 28, y: -46, r: 160 },
  { d: "M359 163 L366 165 L362 170 Z", x: -40, y: -18, r: -90 },
  { d: "M381 165 L388 164 L386 171 Z", x: 46, y: -22, r: 120 },
  { d: "M368 167 L373 170 L367 173 Z", x: -12, y: 34, r: 200 },
  { d: "M373 156 L378 152 L380 158 Z", x: 12, y: -62, r: -220 },
];
// flat, slowly rising before the ceiling; a steep climb after the break (Tom, review 2)
const grey = "M96 205 C170 204 240 198 290 186 S320 172 340 172 C420 172 500 174 580 173";
const orange = "M340 172 C390 172 420 140 455 92 S530 18 576 8";
---
<section id="glass-ceiling-split" class="gx relative" aria-label="The glass ceiling (split layout)">
  <div class="gx-pin">
    <div class="gx-inner mx-auto w-full max-w-[1240px] px-5">

      <div class="gx-copy">
        <h2 class="text-[clamp(28px,min(3.3vw,5.4vh),48px)] font-semibold leading-[1.06] tracking-[-0.04em] text-text">
          The things that got you to $20K–$60K a month <em class="accent">won't be what gets you to $1M a month.</em>
        </h2>
        <div class="paras">
          {paras.map((p, i) => <p class:list={["para", { strong: i === 2 }]} data-i={i}>{p}</p>)}
        </div>
        <p class="q-cap">Here are some examples of things we hear from people at this stage.</p>
        <ul class="quotes">
          {quotes.map((q) => <li class="quote">“{q}”</li>)}
        </ul>
        <p class="push-hint">Keep scrolling to break through <span aria-hidden="true">↓</span></p>
      </div>

      <div class="gx-card">
        <div class="chart">
          <svg viewBox="0 0 600 340" aria-hidden="true">
            <defs>
              <linearGradient id="gx-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="var(--accent)" stop-opacity=".26" />
                <stop offset=".6" stop-color="var(--accent)" stop-opacity=".06" />
                <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="gx-fade-x" x1=".567" y1="0" x2=".82" y2="0">
                <stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset="1" stop-color="#fff" stop-opacity="1" />
              </linearGradient>
              <linearGradient id="gx-line" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="var(--text)" stop-opacity=".3" />
                <stop offset=".3" stop-color="var(--accent)" stop-opacity="1" />
              </linearGradient>
              <mask id="gx-mask"><rect width="600" height="340" fill="url(#gx-fade-x)" /></mask>
              <filter id="gx-glow" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="5" /></filter>
            </defs>
            {axis.map((a) => <text class="ax" x="0" y={a.y + 4}>{a.t}</text>)}
            <!-- ceiling in two halves so it can split open at the impact point -->
            <path class="ceil ceil-l" d={`M96 165 L${IMPACT.x} 165`} />
            <path class="ceil ceil-r" d={`M${IMPACT.x} 165 L580 165`} />
            <text class="lbl ceil-lbl" x="580" y="155" text-anchor="end">Glass ceiling</text>
            {cracks.map((group, s) => (
              <g class="cracks" data-s={s + 1}>{group.map((d) => <path class="crack" pathLength="1" d={d} />)}</g>
            ))}
            {shards.map((sh) => <path class="shard" d={sh.d} style={`--x:${sh.x}px;--y:${sh.y}px;--r:${sh.r}deg`} />)}
            <path class="grey" pathLength="1" d={grey} />
            <text class="lbl talent-lbl" x="580" y="194" text-anchor="end">On talent alone</text>
            <path class="area" mask="url(#gx-mask)" d={`${orange} L576 300 L340 300 Z`} />
            <path class="orange halo" pathLength="1" filter="url(#gx-glow)" d={orange} />
            <path class="orange main" pathLength="1" d={orange} />
            <text class="lbl sys-lbl" x="576" y="58" text-anchor="end">With the system</text>
          </svg>
          <span class="tip" aria-hidden="true"></span>
          <span class="pressure" style={`left:${(IMPACT.x / 600) * 100}%;top:${(IMPACT.y / 340) * 100}%`} aria-hidden="true"></span>
        </div>
        <p class="proof">A warm audience converts at 10 to 30%. Cold traffic converts at 2 to 3%. Without a system to reach and warm up new people, you're capped by the audience you already have.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .gx { height: 560vh; }
  .gx-pin { position: sticky; top: 0; height: 100svh; display: flex; align-items: center; overflow: hidden; }
  .gx-inner { display: grid; grid-template-columns: 1fr 1.08fr; gap: clamp(36px, 5vw, 72px); align-items: center; padding-top: 72px; }

  /* Copy column: the paragraph for the current beat is lit, the others dim */
  .paras { margin-top: clamp(16px, 2.6vh, 26px); display: grid; gap: clamp(10px, 1.6vh, 14px); }
  .para { font-size: clamp(15px, min(1.25vw, 2.1vh), 17px); line-height: 1.55; color: var(--text-2); opacity: .32; transition: opacity .5s var(--ease-out-soft), color .5s; }
  .para.strong { font-weight: 600; color: var(--text); }
  .para.on { opacity: 1; }
  .q-cap { margin-top: clamp(18px, 3vh, 28px); font-size: 13px; color: var(--muted); opacity: 0; transition: opacity .6s; }
  .q-cap.on { opacity: 1; }
  .quotes { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 8px; }
  .quote {
    font-size: 13px; line-height: 1.3; color: var(--text-2); padding: 8px 13px; border-radius: 999px;
    border: 1px solid var(--line); background: color-mix(in srgb, var(--surface) 75%, transparent);
    opacity: 0; transform: translateY(8px) scale(.96); transition: opacity .5s var(--ease-out-soft), transform .5s var(--ease-out-soft);
  }
  .quote.on { opacity: 1; transform: none; }
  /* once the ceiling breaks the quotes stay, but step back like the other paragraphs */
  .gx.broken .quote.on, .gx.broken .q-cap.on { opacity: .32; }
  .push-hint { margin-top: 14px; font-size: 13px; font-weight: 600; color: var(--accent); opacity: 0; transform: translateY(6px); transition: opacity .4s, transform .4s var(--ease-out-soft); }
  .push-hint span { display: inline-block; animation: gx-nudge 1.2s ease-in-out infinite; }
  @keyframes gx-nudge { 50% { transform: translateY(3px); } }
  .gx.pushing .push-hint { opacity: 1; transform: none; }

  /* Chart panel (the mockup's card) */
  .gx-card { position: relative; padding: clamp(20px, 2.4vw, 32px); border-radius: 18px; border: 1px solid var(--line); background: color-mix(in srgb, var(--surface) 85%, transparent); }
  .chart { position: relative; aspect-ratio: 600 / 340; }
  .chart svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ax { font-size: 12px; fill: var(--muted); }
  .lbl { font-size: 13px; font-weight: 600; opacity: 0; transition: opacity .6s; }
  .ceil-lbl { fill: var(--text-2); }
  .talent-lbl { fill: var(--muted); font-weight: 500; }
  .sys-lbl { fill: var(--accent); }
  .proof { margin-top: 18px; font-size: 13px; line-height: 1.55; color: var(--muted); opacity: 0; transition: opacity .7s; }
  .proof.on { opacity: 1; }

  svg .ceil { fill: none; stroke: color-mix(in srgb, var(--text) 32%, transparent); stroke-width: 1; stroke-dasharray: 5 6; opacity: 0; transition: opacity .6s, transform .7s var(--ease-out-soft); }
  .gx.broken svg .ceil-l { transform: translate(-10px, 2px); }
  .gx.broken svg .ceil-r { transform: translate(10px, 2px); }
  svg .crack { fill: none; stroke: rgb(255 236 220 / .85); stroke-width: 1.1; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1 2; stroke-dashoffset: 1; transition: stroke-dashoffset .35s var(--ease-out-soft), opacity .6s; }
  svg .cracks.on .crack { stroke-dashoffset: 0; }
  .gx.broken svg .crack { opacity: .25; }
  svg .shard { fill: rgb(255 240 228 / .9); stroke: rgb(255 115 55 / .6); stroke-width: .5; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .gx.broken svg .shard { animation: gx-shard 1.1s cubic-bezier(.2, .7, .3, 1) forwards; }
  @keyframes gx-shard { 0% { opacity: 1; transform: none; } 100% { opacity: 0; transform: translate(var(--x), var(--y)) rotate(var(--r)) scale(.6); } }
  /* dash 1 / gap 2 so the round cap of the next dash never peeks in at the path end */
  svg .grey, svg .orange { fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1 2; stroke-dashoffset: 1; }
  svg .grey { stroke: color-mix(in srgb, var(--text) 40%, transparent); stroke-width: 2.2; }
  svg .orange.main { stroke: url(#gx-line); stroke-width: 3; }
  svg .orange.halo { stroke: var(--accent); stroke-width: 8; opacity: .4; }
  svg .area { fill: url(#gx-fill); opacity: 0; }

  .pressure {
    position: absolute; width: 160px; height: 90px; margin: -45px 0 0 -80px; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgb(255 170 100 / .7), rgb(255 61 0 / .35) 45%, transparent);
    filter: blur(8px); opacity: 0; transform: scale(.5);
  }
  .gx.broken .pressure { transition: opacity .8s, transform .8s var(--ease-out-soft); opacity: 0 !important; transform: scale(1.8) !important; }
  .tip {
    position: absolute; left: 0; top: 0; width: 11px; height: 11px; margin: -5.5px 0 0 -5.5px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 45%, transparent), 0 0 20px 5px var(--accent);
    opacity: 0; transition: opacity .3s;
  }
  .gx-card.thud { animation: gx-thud .32s cubic-bezier(.3, .7, .4, 1); }
  @keyframes gx-thud { 0% { transform: translateY(0); } 25% { transform: translateY(-5px); } 50% { transform: translateY(3px); } 75% { transform: translateY(-1.5px); } 100% { transform: translateY(0); } }

  /* Phones / tablet portrait: no pin, stacked; every paragraph and quote readable */
  @media (max-width: 899px) {
    .gx { height: auto; padding: 80px 0 40px; }
    .gx-pin { position: relative; height: auto; display: block; overflow: visible; }
    .gx-inner { grid-template-columns: 1fr; gap: 36px; padding-top: 0; }
    .para, .q-cap, .quote { opacity: 1; transform: none; }
    .gx.broken .quote.on, .gx.broken .q-cap.on { opacity: 1; }
    .push-hint { display: none; }
    .ax { font-size: 16px; } .lbl { font-size: 17px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gx { height: auto; } .gx-pin { position: relative; height: auto; padding: 96px 0; }
    .para, .q-cap, .quote, .proof, .lbl { opacity: 1; transform: none; }
    svg .grey, svg .orange { stroke-dashoffset: 0; } svg .area, svg .ceil { opacity: 1; }
    .push-hint, .pressure, .tip { display: none; }
  }
</style>

<script>
  import { onScrollInView } from "../lib/scroll";
  const sec = document.getElementById("glass-ceiling-split")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const mobile = matchMedia("(max-width: 899px)");
  const q = <T extends Element>(s: string) => sec.querySelector<T>(s)!;
  const qa = <T extends Element>(s: string) => [...sec.querySelectorAll<T>(s)];
  const paras = qa<HTMLElement>(".para");
  const quotes = qa<HTMLElement>(".quote");
  const qCap = q<HTMLElement>(".q-cap");
  const card = q<HTMLElement>(".gx-card");
  const svg = q<SVGSVGElement>(".chart svg");
  const grey = q<SVGPathElement>(".grey");
  const oranges = qa<SVGPathElement>(".orange");
  const orange = q<SVGPathElement>(".orange.main");
  const area = q<SVGPathElement>(".area");
  const ceils = qa<SVGPathElement>(".ceil");
  const ceilLbl = q<SVGTextElement>(".ceil-lbl");
  const talentLbl = q<SVGTextElement>(".talent-lbl");
  const sysLbl = q<SVGTextElement>(".sys-lbl");
  const crackGroups = qa<SVGGElement>(".cracks");
  const pressure = q<HTMLElement>(".pressure");
  const tip = q<HTMLElement>(".tip");
  const proof = q<HTMLElement>(".proof");
  const clamp = (v: number) => Math.max(0, Math.min(1, v));
  const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
  const orangeLen = orange.getTotalLength();
  let stage = 0, heavy = false;

  // Scroll resistance via Lenis (wheel / trackpad); touch scrolling is native, so phones get the visuals only
  function setHeavy(on: boolean) {
    if (on === heavy) return;
    heavy = on;
    const vs = (window as any).lenis?.virtualScroll;
    if (vs) vs.options.wheelMultiplier = on ? 0.4 : 1;
  }

  function render() {
    const phone = mobile.matches;
    let p: number, pinned: boolean;
    if (phone) {
      // no pin: the story plays as the panel travels from the bottom of the screen to near the top
      const r = card.getBoundingClientRect();
      p = clamp((innerHeight * 0.9 - r.top) / (innerHeight * 0.75));
      pinned = false;
    } else {
      const r = sec.getBoundingClientRect();
      p = clamp(-r.top / (sec.offsetHeight - innerHeight));
      pinned = r.top <= 0 && r.bottom >= innerHeight;
    }

    // Beats: 1 grey line rises · 2 it stalls at the ceiling, quotes arrive, then you push · 3 it breaks through
    const beat = p < 0.26 ? 0 : p < 0.66 ? 1 : 2;
    paras.forEach((el, i) => el.classList.toggle("on", i === beat));

    grey.style.strokeDashoffset = String(1 - seg(p, 0.03, 0.42));
    const ceilOn = p > 0.28;
    ceilLbl.style.opacity = ceilOn ? "1" : "0";
    talentLbl.style.opacity = String(seg(p, 0.4, 0.46));
    qCap.classList.toggle("on", p > 0.29);
    quotes.forEach((el, i) => el.classList.toggle("on", p > 0.31 + i * 0.03));

    // Hitting the ceiling (p .50 → .66): heavy scroll, pressure builds, three cracks with a thud each, then it shatters
    const push = seg(p, 0.5, 0.66);
    const pushing = pinned && p >= 0.48 && p < 0.66;
    const broken = p >= 0.66;
    sec.classList.toggle("pushing", pushing);
    sec.classList.toggle("broken", broken);
    setHeavy(pushing);
    ceils.forEach((c) => {
      c.style.opacity = ceilOn ? "1" : "0";
      c.style.stroke = `color-mix(in srgb, var(--accent) ${Math.round(push * 85)}%, color-mix(in srgb, var(--text) 32%, transparent))`;
      c.style.strokeWidth = String(1 + push * 1.2);
    });
    if (!broken) {
      pressure.style.opacity = String(push * 0.9);
      pressure.style.transform = `scale(${0.5 + push * 0.7})`;
    }
    const next = push >= 0.85 ? 3 : push >= 0.55 ? 2 : push >= 0.22 ? 1 : 0;
    if (next > stage) { card.classList.remove("thud"); void card.offsetWidth; card.classList.add("thud"); }
    stage = next;
    crackGroups.forEach((g, i) => g.classList.toggle("on", broken || i < stage));

    // Breakthrough: orange line draws with a glowing tip, its label and the fill follow, then the proof line
    const draw = seg(p, 0.67, 0.88);
    oranges.forEach((o) => {
      o.style.strokeDashoffset = String(1 - draw);
      o.style.visibility = draw > 0.001 ? "" : "hidden";
    });
    const pt = orange.getPointAtLength(orangeLen * draw);
    const k = svg.clientWidth / 600;
    tip.style.transform = `translate(${pt.x * k}px, ${pt.y * k}px)`;
    tip.style.opacity = draw > 0.01 && draw < 0.999 ? "1" : "0";
    sysLbl.style.opacity = String(seg(p, 0.84, 0.9));
    area.style.opacity = String(seg(p, 0.72, 0.94));
    grey.style.opacity = String(1 - 0.5 * seg(p, 0.67, 0.8));
    proof.classList.toggle("on", p > 0.86);
  }

  if (!reduce) {
    render();
    onScrollInView(sec, render);
  }
</script>
