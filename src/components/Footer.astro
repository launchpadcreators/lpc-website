---
// Footer — copy: brief/04-copy-deck.md, section 9. Ends with the big LAUNCHPAD and its launching rocket "A".
// TODO: company number [CONFIRM], Privacy / Terms pages (Terms currently pointed at Privacy on the old site),
// and Dan's / Tom's LinkedIn URLs once shared.
import { applyUrl } from "../data/growth-stages";
import { url } from "../config/paths";
const nav = [
  { href: "#growth-system", label: "Growth System" },
  { href: "#results", label: "Results" },
  { href: "#about", label: "About" },
];
// The logo's rocket "A" (same mark as the cursor), used as the A in the big LAUNCHPAD word
const mark = "M168.26 10.0056C175.957 -3.33512 195.211 -3.33512 202.908 10.0056L368.812 297.573C377.101 311.941 362.012 328.46 346.955 321.5L203.626 255.25C192.18 249.959 178.988 249.959 167.543 255.25L24.2135 321.5C9.15635 328.46 -5.93323 311.941 2.35608 297.573L168.26 10.0056ZM191.854 106.978C189.069 102.15 182.101 102.15 179.315 106.978L119.273 211.051C116.273 216.25 121.734 222.228 127.183 219.71L179.054 195.733C183.197 193.819 187.971 193.819 192.113 195.733L243.985 219.71C249.434 222.228 254.895 216.25 251.895 211.051L191.854 106.978Z";
// The hollow triangle inside the mark, filled with the footer colour so the flame and trail behind it never show through
const counter = "M191.854 106.978C189.069 102.15 182.101 102.15 179.315 106.978L119.273 211.051C116.273 216.25 121.734 222.228 127.183 219.71L179.054 195.733C183.197 193.819 187.971 193.819 192.113 195.733L243.985 219.71C249.434 222.228 254.895 216.25 251.895 211.051L191.854 106.978Z";
---
<footer class="ft relative z-10">
  <div class="mx-auto w-full max-w-[1080px] px-6">
    <div class="top">
      <a href="#top" class="brand" aria-label="Launchpad Creators, back to top">
        <img src={url("logo-full.png")} alt="Launchpad Creators" width="907" height="190" />
      </a>
      <nav class="links" aria-label="Footer">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href={applyUrl} target="_blank" rel="noopener" class="work">Work with us</a>
      </nav>
    </div>

    <div class="bottom">
      <p>© 2026 Launchpad Creators Limited · 3rd Floor, 86-90 Paul Street, London EC2A 4NE</p>
      <div class="legal">
        <!-- Privacy Policy lives on the current launchpadcreators.com. There is no Terms of Use page yet
             (the old site pointed it at the privacy policy), so that link comes back once the page exists. -->
        <a href="https://launchpadcreators.com/privacy-policy/" target="_blank" rel="noopener">Privacy Policy</a>
        <a href="mailto:hello@launchpadcreators.com">hello@launchpadcreators.com</a>
      </div>
    </div>

    <!-- Closing moment (Tom's reviews): a big LAUNCHPAD whose "A" is our rocket mark, in white. When you reach the
         bottom of the page it rumbles, lifts off with a faded blue trail and flies away out of sight. It resets once
         the word is scrolled out of view, so it flies again next time. Decorative only. -->
    <div class="lp-wrap" aria-hidden="true">
      <div class="lp">
        <span>L</span><span class="slot">
          <span class="rocket">
            <span class="trail"></span>
            <span class="flame"></span>
            <svg viewBox="0 0 372 324"><path class="counter" d={counter} /><path class="body" d={mark} /></svg>
          </span>
        </span><span>UNCHPAD</span>
      </div>
    </div>
  </div>
</footer>

<style>
  /* overflow clips the rocket as it flies out of the top of the footer */
  .ft { --ft-bg: color-mix(in srgb, var(--surface) 40%, var(--bg)); padding: 48px 0 0; overflow: hidden; border-top: 1px solid var(--line); background: var(--ft-bg); }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; }
  .brand img { display: block; height: 34px; width: auto; }
  .links { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; font-size: 14px; color: var(--text-2); }
  .links a { transition: color .2s; }
  .links a:hover { color: var(--text); }
  .links .work { color: var(--accent); font-weight: 600; }
  .bottom { margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 16px 32px; flex-wrap: wrap; font-size: 13px; color: var(--muted); }
  .legal { display: flex; gap: 22px; flex-wrap: wrap; }
  .legal a { transition: color .2s; }
  .legal a:hover { color: var(--text); }
  @media (max-width: 767px) { .links { gap: 18px; } }

  /* Big LAUNCHPAD: sized to the column width (container units), faint letters, the rocket A in white */
  .lp-wrap { container-type: inline-size; margin-top: clamp(28px, 5vw, 56px); }
  .lp {
    font-size: 16.6cqw; font-weight: 800; line-height: .8; letter-spacing: -0.055em; white-space: nowrap; text-align: center;
    padding-bottom: .06em; color: color-mix(in srgb, var(--text) 7%, transparent);
    user-select: none; -webkit-user-select: none;
  }
  /* The A slot keeps its width while the rocket is away, so the word never reflows */
  .slot { position: relative; display: inline-block; width: .84em; height: .73em; margin: 0 .015em 0 -.01em; vertical-align: baseline; }
  .rocket { position: absolute; inset: 0; }
  /* white mark, a touch bigger than the letters (scaled from its base so it still sits on the baseline) */
  .rocket svg {
    position: absolute; inset: 0; width: 100%; height: 100%; transform: scale(1.12); transform-origin: 50% 100%;
    filter: drop-shadow(0 0 .05em rgb(255 255 255 / .28));
  }
  .rocket .body { fill: #fff; }
  .rocket .counter { fill: var(--ft-bg); }
  /* small white-blue engine flame out of the notch at the bottom of the mark */
  .flame {
    position: absolute; left: 50%; top: 82%; width: .18em; height: .42em; margin-left: -.09em; transform-origin: 50% 0;
    border-radius: 50% 50% 50% 50% / 28% 28% 72% 72%;
    background: radial-gradient(50% 60% at 50% 22%, #fff 0%, #d6e6ff 34%, rgb(110 160 255 / .7) 66%, transparent 100%);
    filter: blur(.01em); opacity: 0; transform: scaleY(0);
  }
  /* faded blue exhaust trail hanging from the engine, travelling with the rocket */
  .trail {
    position: absolute; left: 50%; top: 86%; width: .11em; height: 2.4em; margin-left: -.055em; border-radius: 99px;
    transform-origin: 50% 0; transform: scaleY(0); opacity: 0; filter: blur(.035em);
    background: linear-gradient(to bottom, rgb(185 212 255 / .5), rgb(120 165 255 / .18) 35%, rgb(255 255 255 / .04) 70%, transparent);
  }

  /* One 2.6s launch, one way: short rumble → accelerating lift-off → fades as it leaves the top of the footer */
  .lp.go .rocket { animation: lp-rocket 2.6s forwards; }
  .lp.go .flame { animation: lp-flame 2.6s forwards, lp-flicker .1s steps(2) infinite; }
  .lp.go .trail { animation: lp-trail 2.6s forwards; }
  @keyframes lp-rocket {
    0% { transform: none; opacity: 1; animation-timing-function: linear; }
    5% { transform: translate(-1.2%, 0); } 10% { transform: translate(1.2%, -1%); } 15% { transform: translate(-1%, 0); }
    18% { transform: translate(0, -2%); animation-timing-function: cubic-bezier(.55, 0, .85, .4); }
    72% { transform: translateY(-420%); opacity: 1; }
    88%, 100% { transform: translateY(-540%); opacity: 0; }
  }
  @keyframes lp-flame {
    0% { transform: scaleY(0); opacity: 0; } 5% { transform: scaleY(.45); opacity: 1; } 18% { transform: scaleY(1.05); }
    72% { transform: scaleY(1.5); opacity: 1; } 88%, 100% { transform: scaleY(1.5); opacity: 0; }
  }
  @keyframes lp-flicker { 50% { scale: .88 1.14; } }
  /* grows only once the rocket is moving, lengthening as it speeds up, then fades with it */
  @keyframes lp-trail {
    0%, 18% { transform: scaleY(0); opacity: 0; } 26% { transform: scaleY(.25); opacity: .75; }
    72% { transform: scaleY(1); opacity: .55; } 92%, 100% { transform: scaleY(1); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .lp.go :is(.rocket, .flame, .trail) { animation: none; } }
</style>

<script>
  // Launch once the big word is (almost) fully on screen, i.e. you've reached the bottom; reset when it's scrolled
  // out of view so it flies again on the next visit to the bottom. Reduced motion: the rocket just stays put.
  const lp = document.querySelector<HTMLElement>(".ft .lp")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let timer = 0;
  if (!reduce) {
    new IntersectionObserver(([en]) => {
      clearTimeout(timer);
      if (en.intersectionRatio >= 0.85) timer = window.setTimeout(() => lp.classList.add("go"), 350);
      else if (!en.isIntersecting) lp.classList.remove("go");
    }, { threshold: [0, 0.85] }).observe(lp);
  }
</script>
