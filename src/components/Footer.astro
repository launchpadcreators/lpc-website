---
// Footer — copy: brief/04-copy-deck.md, section 9. Also holds our rocket mark, which lifts off as you scroll to the closing card.
// TODO: company number [CONFIRM].
import { applyUrl } from "../data/growth-stages";
import { url } from "../config/paths";
// Section links scroll on the homepage; from other pages (e.g. /results) they go to the homepage section
const onHome = Astro.url.pathname.replace(/\/$/, "") === url("/").replace(/\/$/, "");
const to = (hash: string) => (onHome ? hash : `${url("/")}${hash}`);
const nav = [
  { href: to("#growth-system"), label: "Growth System" },
  { href: to("#results"), label: "Results" },
  { href: to("#about"), label: "About" },
];
// The logo's rocket mark (same as the cursor)
const mark = "M168.26 10.0056C175.957 -3.33512 195.211 -3.33512 202.908 10.0056L368.812 297.573C377.101 311.941 362.012 328.46 346.955 321.5L203.626 255.25C192.18 249.959 178.988 249.959 167.543 255.25L24.2135 321.5C9.15635 328.46 -5.93323 311.941 2.35608 297.573L168.26 10.0056ZM191.854 106.978C189.069 102.15 182.101 102.15 179.315 106.978L119.273 211.051C116.273 216.25 121.734 222.228 127.183 219.71L179.054 195.733C183.197 193.819 187.971 193.819 192.113 195.733L243.985 219.71C249.434 222.228 254.895 216.25 251.895 211.051L191.854 106.978Z";
---
<footer class="ft relative z-10">
  <div class="mx-auto w-full max-w-[1080px] px-6">
    <div class="top">
      <a href="#top" class="brand" aria-label="Launchpad Creators, back to top">
        <img src={url("logo-full.png")} alt="Launchpad Creators" width="907" height="190" />
      </a>
      <nav class="links" aria-label="Footer">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href={applyUrl} target="_blank" rel="noopener" class="work">Work with us</a>
      </nav>
    </div>

    <div class="bottom">
      <p>© 2026 Launchpad Creators Limited · 3rd Floor, 86-90 Paul Street, London EC2A 4NE</p>
      <div class="legal">
        <!-- Our own copies of the old WordPress pages, at the same addresses (/privacy-policy/, /terms-of-use/) -->
        <a href={url("privacy-policy/")}>Privacy Policy</a>
        <a href={url("terms-of-use/")}>Terms of Use</a>
        <a href="mailto:hello@launchpadcreators.com">hello@launchpadcreators.com</a>
      </div>
    </div>

    <!-- Closing moment (Tom, review 2): our rocket mark in white, centred. It lifts off in step with the scroll: on
         the way to the closing card it rises in from the bottom of the screen with a flame and a faded blue trail,
         and has flown out past the top by the time the card is fully on screen. Scrolling back up brings it back
         down. Fixed to the screen, so it takes no space in the footer. Decorative only. -->
    <div class="rocket" aria-hidden="true">
        <span class="trail"></span>
        <span class="flame"></span>
        <svg viewBox="0 0 372 324"><path d={mark} /></svg>
    </div>
  </div>
</footer>

<style>
  .ft { --ft-bg: color-mix(in srgb, var(--surface) 40%, var(--bg)); padding: 48px 0 40px; border-top: 1px solid var(--line); background: var(--ft-bg); }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; }
  .brand img { display: block; height: 34px; width: auto; }
  .links { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; font-size: 14px; color: var(--text-2); }
  .links a { transition: color .2s; }
  .links a:hover { color: var(--text); }
  .links .work { color: var(--accent); font-weight: 600; }
  .bottom { margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 16px 32px; flex-wrap: wrap; font-size: 13px; color: var(--muted); }
  .legal { display: flex; gap: 22px; flex-wrap: wrap; }
  .legal a { transition: color .2s; }
  .legal a:hover { color: var(--text); }
  @media (max-width: 767px) { .links { gap: 18px; } }

  /* Fixed to the screen and parked just below its bottom edge; the script lifts it into view with the scroll */
  .rocket {
    position: fixed; left: 50%; top: 100%; pointer-events: none; visibility: hidden; width: clamp(130px, 13vw, 210px); aspect-ratio: 372 / 324; margin-left: calc(clamp(130px, 13vw, 210px) / -2);
    will-change: transform, opacity;
  }
  /* solid white with a gentle blue-white glow */
  .rocket svg { position: relative; z-index: 1; display: block; width: 100%; height: 100%; fill: #fff; filter: drop-shadow(0 0 18px rgb(150 190 255 / .25)); }
  /* white-blue engine flame out of the notch at the bottom of the mark; grows as it climbs */
  .flame {
    position: absolute; left: 50%; top: 82%; width: 22%; height: 52%; margin-left: -11%; transform-origin: 50% 0;
    border-radius: 50% 50% 50% 50% / 28% 28% 72% 72%;
    background: radial-gradient(50% 60% at 50% 22%, #fff 0%, #d6e6ff 34%, rgb(110 160 255 / .7) 66%, transparent 100%);
    filter: blur(1px); transform: scaleY(0); opacity: 0;
  }
  .flame.lit { animation: lp-flicker .1s steps(2) infinite; }
  @keyframes lp-flicker { 50% { scale: .88 1.14; } }
  /* faded blue exhaust trail hanging from the engine, lengthening with the climb */
  .trail {
    position: absolute; left: 50%; top: 86%; width: 12%; height: 520%; margin-left: -6%; border-radius: 99px;
    transform-origin: 50% 0; transform: scaleY(0); opacity: 0; filter: blur(4px);
    background: linear-gradient(to bottom, rgb(185 212 255 / .55), rgb(120 165 255 / .2) 35%, rgb(255 255 255 / .04) 70%, transparent);
  }
</style>

<script>
  import { onScrollInView } from "../lib/scroll";
  // Scroll-linked lift-off, timed to the closing "Ready to scale?" card: the rocket leaves the top of the screen just
  // as the card becomes fully visible. It climbs twice as fast as the page scrolls (so it reads as flying, not sitting
  // on the page), which sets when it appears: around when the card's top edge reaches the bottom of the screen. The rocket comes up from the bottom of the screen
  // already solid, flame and trail lit (no fade in), climbs steadily, and has flown out past the top (fading over the
  // last moment) by the time the card is in view. Reduced motion: no rocket.
  const ft = document.querySelector<HTMLElement>(".ft")!;
  const rocket = ft.querySelector<HTMLElement>(".rocket")!;
  // pages without the closing card (Privacy Policy, Terms of Use) have no rocket
  const card = document.querySelector<HTMLElement>("#newsletter .card");
  const flame = rocket.querySelector<HTMLElement>(".flame")!;
  const trail = rocket.querySelector<HTMLElement>(".trail")!;
  const clamp = (v: number) => Math.max(0, Math.min(1, v));

  const render = () => {
    const r = card!.getBoundingClientRect();
    const end = Math.max(innerHeight - 24 - r.height, innerHeight * 0.12); // card fully in view (or its top near the top, if taller than the screen)
    const climb = innerHeight + rocket.offsetHeight; // from just below the screen to just above it
    const start = end + climb / 2; // 2x the scroll speed
    const p = clamp((start - r.top) / (start - end));
    rocket.style.visibility = p > 0 && p < 1 ? "visible" : "hidden";
    // from just below the screen up and out past the top, gently speeding up
    const lift = Math.pow(p, 1.1) * climb;
    rocket.style.transform = `translate3d(0, ${-lift}px, 0)`;
    // fade by where it is on screen: starts once its top passes a third of the way down from the top of the
    // screen, fully faded as it leaves, so the fade is always visible
    const y = innerHeight - lift; // rocket's top edge on screen
    const fadeFrom = innerHeight * 0.34, fadeTo = -rocket.offsetHeight * 0.4;
    const f = clamp((fadeFrom - y) / (fadeFrom - fadeTo));
    rocket.style.opacity = String(1 - f * f * (3 - 2 * f));
    // flame and trail are already lit when it appears, and stretch out as it speeds up
    flame.style.transform = `scaleY(${0.9 + p * 0.7})`;
    flame.style.opacity = "1";
    flame.classList.toggle("lit", p > 0);
    trail.style.transform = `scaleY(${0.55 + p * 0.45})`;
    trail.style.opacity = "0.8";
  };
  if (card) {
    render();
    onScrollInView(card, render, "200% 0px");
  }
</script>
