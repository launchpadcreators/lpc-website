---
// Close — one wide accent card with the apply call-to-action, centred, inside a framed panel (frame drops away on mobile).
// The mailing-list card that sat inside it moved to the nav's "Join Newsletter" pop-up (Tom, 30 Oct; NewsletterDialog.astro).
// Copy: brief/04-copy-deck.md, section 8. The section keeps id="newsletter": the footer rocket times its lift-off to this card.
import { applyUrl } from "../data/growth-stages";
---
<section id="newsletter" class="cl relative" aria-label="Apply to work with us">
  <div class="mx-auto w-full max-w-[1080px] px-6">
    <div class="frame" data-reveal>
      <div class="card">

        <!-- Work with us -->
        <div class="apply">
          <h2 class="title">Ready to <em class="accent">scale?</em></h2>
          <!-- Tom's homepage copy doc (29 Oct) -->
          <p class="body">We take on a small number of partners at a time. Tell us where your business is now, and we'll let you know if we're the right fit.</p>
          <a class="btn-dark" href={applyUrl} target="_blank" rel="noopener">Apply to work with us <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cl { padding: clamp(80px, 12vh, 140px) 0 clamp(64px, 10vh, 110px); }

  /* Framed panel (same treatment as the What we do bento) */
  .frame { padding: 20px; border-radius: 22px; background: color-mix(in srgb, var(--surface) 55%, var(--bg)); border: 1px solid var(--line); }

  .card {
    position: relative; overflow: hidden; isolation: isolate; border-radius: 16px;
    display: flex; justify-content: center; text-align: center;
    padding: clamp(48px, 7vw, 88px) clamp(24px, 5vw, 64px);
    /* the brand accent, light-to-deep, with grain (no rings) */
    background: var(--accent-card);
  }
  .card::after { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: var(--noise); background-size: 180px; opacity: .3; mix-blend-mode: overlay; }
  .card > * { position: relative; z-index: 1; }
  .apply { display: flex; flex-direction: column; align-items: center; }

  .title { font-size: clamp(36px, 4.4vw, 60px); font-weight: 600; letter-spacing: -0.045em; line-height: 1.02; color: #fff; }
  .title .accent { color: #fff; }
  .body { margin-top: 16px; max-width: 480px; font-size: 16px; line-height: 1.55; color: rgb(255 255 255 / .88); }
  .btn-dark {
    margin-top: 28px; display: inline-flex; align-items: center; gap: 8px; height: 52px; padding: 0 24px; border-radius: 12px;
    font-size: 16px; font-weight: 600; color: #fff; background: #0E0E10; box-shadow: 0 12px 30px -12px rgb(0 0 0 / .55);
    transition: transform .2s var(--ease-out-soft), box-shadow .2s;
  }
  .btn-dark:hover { transform: translateY(-2px); box-shadow: 0 16px 34px -12px rgb(0 0 0 / .65); }
  .btn-dark span { transition: transform .2s var(--ease-out-soft); }
  .btn-dark:hover span { transform: translateX(3px); }

  /* mobile: no outer frame, tighter card so it uses the full width */
  @media (max-width: 767px) {
    .frame { padding: 0; border: 0; background: none; }
    .card { padding: 44px 20px; }
  }
</style>
