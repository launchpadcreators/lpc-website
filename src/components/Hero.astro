---
// Hero: centred headline with one serif accent word, sub-copy and two CTAs.
// (The partner faces and "Partnering with the world's best..." line were removed at Tom's request, 31 Oct.)
const applyUrl = "https://form.typeform.com/to/yWBgS4vK";
---
<section id="top" class="hero relative flex min-h-svh flex-col items-center justify-center overflow-hidden px-5 pt-[104px] pb-[56px]">
  <!-- The brand glow: one Blue Flame light rising from the bottom centre (brand guidelines, Nov 2026) -->
  <div class="glow" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto flex max-w-[1120px] flex-col items-center text-center">
    <!-- Phones: always 3 lines (Abdullah, 1 Nov), with a size that shrinks with the screen so "creator businesses." never
         wraps. Tablet and desktop wrap naturally, as before. -->
    <h1 class="hero-h1 h-in font-medium leading-[1.02] tracking-[-0.045em] text-text" style="--d:90ms">
      We build and scale<br class="md:hidden" /> <span class="accent text-[1.08em] whitespace-nowrap">7 and 8 figure</span><br class="md:hidden" /> creator businesses.
    </h1>

    <!-- white (was grey) since the brand glow is darker (Tom, 6 Nov) -->
    <p class="h-in mt-7 max-w-[640px] text-[clamp(16px,1.6vw,19px)] leading-relaxed text-text" style="--d:180ms">
      Growth partners for founders, experts and creators to monetise their audience and expertise, and scale to 7 and 8 figures.
    </p>

    <div class="h-in mt-10 flex flex-col items-center gap-3 sm:flex-row" style="--d:270ms">
      <a href={applyUrl} target="_blank" rel="noopener" class="hbtn hbtn-primary">Work with us</a>
      <a href="#join-newsletter" class="hbtn hbtn-ghost">Join our mailing list</a>
    </div>
  </div>
</section>

<style>
  /* The brand glow (Nov 2026, replacing the spinning conic glow): a wide half-ellipse sitting on the bottom edge, as in
     the brand's example backgrounds (about 1.65 times as wide as it is tall). Still, no movement. The gradient comes
     from themes.css. A fine black grain on top (Abdullah, 6 Nov) keeps it from looking flat. */
  .glow {
    position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); pointer-events: none;
    width: clamp(720px, 100vw, 1800px); height: clamp(280px, 30vw, 545px);
    background: var(--hero-glow, radial-gradient(ellipse 50% 100% at 50% 100%, rgb(var(--accent-rgb)) 0%, rgb(var(--accent-rgb) / .3) 30%, transparent 80%));
  }
  .glow::after { content: ""; position: absolute; inset: 0; background-image: var(--noise-dark); background-size: 180px; opacity: .5; }

  .hbtn {
    display: inline-flex; align-items: center; justify-content: center;
    height: 52px; padding: 0 26px; border-radius: 12px;
    font-size: 16px; font-weight: 600;
    transition: transform .2s var(--ease-out-soft), filter .2s, background-color .2s, border-color .2s;
  }
  .hbtn:hover { transform: translateY(-1px); }
  .hbtn-primary { background: var(--accent-grad); color: var(--accent-ink); }
  .hbtn-primary:hover { filter: brightness(1.08); }
  .hbtn-ghost { background: color-mix(in srgb, var(--surface) 80%, transparent); color: var(--text); border: 1px solid var(--line); }
  .hbtn-ghost:hover { border-color: color-mix(in srgb, var(--text) 25%, transparent); }
  @media (max-width: 639px) { .hbtn { width: 100%; min-width: 260px; } }

  /* 40px to 84px as before; on phones never wider than the screen: "creator businesses." is ~8.5em wide (8.9 leaves a margin),
     and the hero has 20px padding each side */
  .hero-h1 { font-size: min(84px, max(40px, 6.4vw), calc((100vw - 40px) / 8.9)); }

  /* Load-in: staggered fade-up */
  .h-in { animation: h-in .9s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: var(--d); }
  @keyframes h-in { from { opacity: 0; transform: translateY(18px); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }
</style>
