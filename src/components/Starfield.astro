---
// Lenis-style starfield: fixed canvas behind the page.
// Small twinkling stars in white and brand orange, slow drift, parallax on scroll.
---
<canvas id="starfield" aria-hidden="true"></canvas>

<style>
  #starfield {
    position: fixed; inset: 0; width: 100%; height: 100%;
    z-index: 0; pointer-events: none;
    background:
      radial-gradient(60% 50% at 75% 110%, color-mix(in srgb, var(--glow-warm) 8%, transparent), transparent 70%),
      radial-gradient(70% 60% at 10% -10%, color-mix(in srgb, var(--glow-cool) 14%, transparent), transparent 70%),
      var(--bg);
  }
</style>

<script>
  const canvas = document.getElementById("starfield") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const DPR = Math.min(window.devicePixelRatio || 1, 2);

  type Star = { x: number; y: number; r: number; a: number; tw: number; ph: number; depth: number; orange: boolean; vx: number; vy: number };
  let stars: Star[] = [];
  // star colours come from the active theme (themes.css: --star, --star-accent as "r g b")
  const css = getComputedStyle(document.documentElement);
  const rgb = (v: string, fb: string) => (css.getPropertyValue(v).trim() || fb).split(/\s+/).join(",");
  const STAR = rgb("--star", "245 247 252"), ACCENT = rgb("--star-accent", "255 100 50");
  let w = 0, h = 0, scrollY = window.scrollY;

  function resize() {
    w = window.innerWidth; h = window.innerHeight;
    canvas.width = w * DPR; canvas.height = h * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    // density scales with screen area, fewer on mobile
    const count = Math.round(Math.min(260, (w * h) / 7000));
    stars = Array.from({ length: count }, () => {
      const depth = Math.random();
      return {
        x: Math.random() * w, y: Math.random() * h,
        r: 0.4 + depth * 1.3,
        a: 0.45 + Math.random() * 0.55,
        tw: 0.4 + Math.random() * 1.6,
        ph: Math.random() * Math.PI * 2,
        depth,
        orange: true, // all stars use the theme accent colour
        vx: (Math.random() - 0.5) * 0.02 * (0.3 + depth),
        vy: -0.01 - Math.random() * 0.02 * (0.3 + depth),
      };
    });
  }

  // Colours are set once; each star's brightness goes through globalAlpha (no colour string built per star per frame)
  const ACCENT_RGB = `rgb(${ACCENT})`, STAR_RGB = `rgb(${STAR})`;
  function draw(t: number, dt: number) {
    ctx.clearRect(0, 0, w, h);
    const time = t / 1000;
    const k = dt / 16.7; // drift per frame scaled to elapsed time, so speed is the same at 30 and 60fps
    for (const s of stars) {
      s.x += s.vx * k; s.y += s.vy * k;
      if (s.x < -2) s.x = w + 2; if (s.x > w + 2) s.x = -2;
      if (s.y < -2) s.y = h + 2; if (s.y > h + 2) s.y = -2;
      // parallax: nearer stars move more with scroll
      const py = (((s.y - scrollY * (0.04 + s.depth * 0.12)) % h) + h) % h;
      const twinkle = 0.55 + 0.45 * Math.sin(time * s.tw + s.ph);
      const alpha = s.a * twinkle;
      ctx.fillStyle = s.orange ? ACCENT_RGB : STAR_RGB;
      ctx.globalAlpha = s.orange ? alpha : alpha * 0.9;
      ctx.beginPath();
      ctx.arc(s.x, py, s.r, 0, Math.PI * 2);
      ctx.fill();
      if (s.r > 1.3) { // soft glow on the larger stars
        ctx.globalAlpha = s.orange ? alpha * 0.12 : alpha * 0.08;
        ctx.beginPath(); ctx.arc(s.x, py, s.r * 3, 0, Math.PI * 2);
        ctx.fill();
      }
    }
    ctx.globalAlpha = 1;
  }

  // Phones and tablets draw at 30fps: the twinkle is slow, so it looks the same and halves the work
  const touch = matchMedia("(hover: none) and (pointer: coarse) and (max-width: 1023px)").matches;
  const FRAME = touch ? 1000 / 30 - 1 : 0;
  let running = true, last = 0;
  function loop(t: number) {
    if (running && t - last >= FRAME) { draw(t, last ? Math.min(t - last, 100) : 16.7); last = t; }
    requestAnimationFrame(loop);
  }

  resize();
  window.addEventListener("resize", resize, { passive: true });
  window.addEventListener("scroll", () => { scrollY = window.scrollY; }, { passive: true });
  document.addEventListener("visibilitychange", () => { running = !document.hidden; });
  requestAnimationFrame(loop);
</script>
