---
// How we work — two partnership models as cards, not a table (Tom: "I don't want this to look like a simple table").
// Rows line up across the two cards so they compare at a glance. Hovering the Consultancy goal ("…take over as your
// Growth Partner") lights up the Growth Partner card. On phones the two cards stack one after the other.
// Copy: brief/04-copy-deck.md, section 6.
import { applyUrl } from "../data/growth-stages";
const models = [
  {
    key: "growth", name: "Growth Partner",
    // Copy for both cards: Tom's homepage copy doc (29 Oct), word for word
    rows: [
      { l: "Who it's for", v: "Founders and experts typically doing 7 figures a year with a proven, scalable offer, or with an audience big enough that the path to 7 figures is already clear." },
      { l: "Your current situation", v: "You know there's an 8-figure business in here. Right now it's inconsistent, it depends on you, and you're not sure how to scale it." },
      { l: "What we do", v: "Our team runs your entire funnel end to end, from strategy through to execution." },
      { l: "What you do", v: "You stay the face of the business while our team runs the machine behind it." },
    ],
    goal: "Scale to 8 figures without running the day-to-day.",
  },
  {
    key: "consult", name: "Consultancy Partner",
    rows: [
      { l: "Who it's for", v: "You've got a proven offer that customers already pay for, and you're bringing in $20K to $75K a month." }, // Tom's comment on the copy doc: $100K is too high
      { l: "Your current situation", v: "Some months are great and others are quiet, and you don't have a clear plan to get past where you are." },
      { l: "What we do", v: "We diagnose your funnel, build your roadmap and coach your team through every stage of it." },
      { l: "What you do", v: "You and your team execute, with us guiding every step." },
    ],
    goal: "Reach 7 figures with predictable, repeatable revenue.",
  },
];
---
<section id="how-we-work" class="hw relative" aria-label="How we work">
  <div class="mx-auto w-full max-w-[1080px] px-6">
    <div class="text-center" data-reveal>
      <h2 class="text-[clamp(30px,3.6vw,52px)] font-semibold leading-[1.05] tracking-[-0.04em] text-text">
        Two ways to <em class="accent">partner with us.</em>
      </h2>
    </div>

    <!-- Side by side on desktop; stacked one after the other on phones (Tom, review 2) -->
    <div class="cards" data-reveal>
      {models.map((m, i) => (
        <article class={`card c-${m.key}`} data-k={m.key}>
          <div class="card-head">
            <span class="badge">{i === 0 ? "01" : "02"}</span>
            <h3 class="name">{m.name}</h3>
          </div>
          <dl class="rows">
            {m.rows.map((r) => (
              <div class="row"><dt>{r.l}</dt><dd>{r.v}</dd></div>
            ))}
            <div class="row goal" data-goal={m.key}><dt>The goal</dt><dd>{m.goal}</dd></div>
          </dl>
        </article>
      ))}
    </div>

    <div class="foot" data-reveal>
      <p class="small">Fit depends on your revenue, business setup and capacity, not one number. We'll tell you honestly which one suits you.</p>
      <a class="btn" href={applyUrl} target="_blank" rel="noopener">Work with us <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .hw { padding: clamp(96px, 14vh, 160px) 0; }

  /* Subgrid: each card spans 6 shared rows (head + 5 rows), so "Who it's for", "What we do"… line up across both cards */
  .cards { margin-top: clamp(40px, 6vh, 64px); display: grid; grid-template-columns: 1fr 1fr; column-gap: 20px; row-gap: 0; }
  .card {
    display: grid; grid-row: span 6; grid-template-rows: subgrid;
    position: relative; overflow: hidden; isolation: isolate; padding: 32px; border-radius: 18px;
    background: var(--surface); border: 1px solid var(--line);
    transition: border-color .4s, box-shadow .4s, transform .4s var(--ease-out-soft);
  }
  .card::after { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: var(--noise); background-size: 180px; opacity: .1; mix-blend-mode: overlay; }
  /* Both cards share the warm gradient and accent outline (Tom: the Consultancy card looked greyed out next to
     Growth Partner, they should look the same) */
  .c-growth, .c-consult {
    background:
      radial-gradient(90% 55% at 100% 0%, rgb(var(--accent-rgb) / .32), transparent 62%),
      linear-gradient(165deg, rgb(var(--accent-rgb) / .16) 0%, rgb(var(--accent-rgb) / .04) 45%, transparent 75%),
      var(--surface);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }
  .card:hover { transform: translateY(-3px); }
  .card.lit { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 24px 60px -24px rgb(var(--accent-rgb) / .6); }

  .card-head { display: flex; align-items: center; gap: 14px; }
  .badge { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 11px; font-size: 13px; font-weight: 700; color: var(--accent); background: var(--raised); border: 1px solid var(--line); }
  .c-growth .badge, .c-consult .badge { color: var(--accent-ink); background: var(--accent-fill); border-color: var(--accent-fill); }
  .name { font-size: clamp(24px, 2.3vw, 30px); font-weight: 600; letter-spacing: -0.03em; color: var(--text); }

  .rows { grid-row: span 5; margin-top: 26px; display: grid; grid-template-rows: subgrid; }
  .row { display: grid; gap: 6px; padding: 16px 0; border-top: 1px solid var(--line); align-content: start; }
  dt { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  dd { font-size: 15px; line-height: 1.55; color: var(--text-2); }
  .goal dd { font-size: 19px; font-weight: 600; line-height: 1.35; letter-spacing: -0.02em; color: var(--accent); }
  .goal[data-goal="consult"] { cursor: default; }

  .foot { margin-top: 36px; display: flex; flex-direction: column; align-items: center; gap: 22px; text-align: center; }
  .small { max-width: 560px; font-size: 14px; line-height: 1.55; color: var(--muted); }
  .btn {
    display: inline-flex; align-items: center; gap: 8px; height: 52px; padding: 0 26px; border-radius: 12px;
    font-size: 16px; font-weight: 600; color: var(--accent-ink); background: var(--accent-grad); transition: transform .2s var(--ease-out-soft), filter .2s;
  }
  .btn:hover { transform: translateY(-1px); filter: brightness(1.08); }
  .btn span { transition: transform .2s var(--ease-out-soft); }
  .btn:hover span { transform: translateX(3px); }

  /* Phones: the two cards stack, one after the other */
  @media (max-width: 767px) {
    .cards { grid-template-columns: 1fr; row-gap: 16px; margin-top: 32px; }
    .card { display: block; padding: 24px; grid-row: auto; }
    .card:hover { transform: none; }
    .rows { display: block; }
  }
</style>

<script>
  const sec = document.getElementById("how-we-work")!;
  // Consultancy goal → light up the Growth Partner card (that's where it leads)
  const growth = sec.querySelector<HTMLElement>(".c-growth")!;
  const goal = sec.querySelector<HTMLElement>('[data-goal="consult"]')!;
  goal.addEventListener("mouseenter", () => growth.classList.add("lit"));
  goal.addEventListener("mouseleave", () => growth.classList.remove("lit"));
</script>
