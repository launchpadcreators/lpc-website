---
// Partners and results, modelled on the LeverBrands "The results" cards Tom pointed to in the brief:
// same size, layout and type scale (3:2 photo, name, niche, one-line bio, result sentence, stats). No video/testimonial slot for now.
// The result sentence is the headline result + supporting line; stat figures come from that copy.
// Copy is word for word from brief/04-copy-deck.md, section 4 (every figure needs partner sign-off before launch).
// Cards sit in an infinite carousel that moves on one card every 1.5s; you can also swipe / drag / use the arrows.
// Motion: cards fade up one after another and the stat numbers count up (photos stay still).
// Pager under the row: ‹ one dot per partner ›.
import { url } from "../config/paths";
// Partner photos live in public/partners/ (white-background shots are cut out onto the dark warm backdrop).
// Order per Tom (review 2): Chris first, then Joseph, then Nicolas, so Chris always shows first, especially on phones.
const partners = [
  {
    name: "Chris Donnelly", niche: "Personal Branding and Business Growth", bio: "Serial entrepreneur who has built and scaled three 8-figure businesses and one 9-figure business.",
    img: "/partners/chris-donnelly.jpg", pos: "50% 50%",
    headline: "6.5x ROAS on the first cohort", line: "Then full ownership of marketing, sales and product.",
    stats: [{ v: "6.5x", l: "ROAS, first cohort" }],
  },
  {
    name: "Joseph McClendon III", niche: "Health and Fitness", bio: "Performance coach who has taught over 6 million people worldwide on mindset, health and longevity.",
    img: "/partners/joseph-mcclendon.jpg", pos: "50% 22%",
    headline: "16x ROAS on launch", line: "From zero to launch in 2 months.",
    stats: [{ v: "16x", l: "ROAS on launch" }, { v: "2", l: "Months to launch" }],
  },
  {
    name: "Nicolas Boucher", niche: "AI Finance", bio: "World's leading expert in AI finance, with a community of 3,000+ senior finance leaders.",
    img: "/partners/nicolas-boucher.jpg", pos: "50% 50%",
    headline: "$50K → $650K a month", line: "In around 9 months.", // [CONFIRM sign-off: ex-partner]
    stats: [{ v: "$650K", l: "A month" }, { v: "9", l: "Months" }],
  },
  {
    name: "Jo Bird", niche: "Personal Branding", bio: "", // [TODO bio from Tom]
    img: "/partners/jo-bird.jpg", pos: "50% 50%",
    headline: "$30K first launch, $0 ad spend", line: "Her first launch with us.", // [CONFIRM public figure]
    stats: [{ v: "$30K", l: "First launch" }, { v: "$0", l: "Ad spend" }],
  },
];
// Split a headline into text and number parts so the numbers can count up ("$50K → $650K" → "$", 50, "K → $", 650, "K")
// Rotating line above the cards (Tom, review 2). Each item carries its own article so "coaching" reads on its own.
const rotating = ["a community", "a SaaS", "coaching", "a cohort", "a course"];
const parts = (s: string) => s.split(/(\d+(?:\.\d+)?)/).map((t, i) => (i % 2 ? { n: +t, dec: (t.split(".")[1] ?? "").length, t } : { t }));
---
<section id="results" class="pr relative" aria-label="Partners and results">
  <!-- 1080px container with 24px gutters, same as the LeverBrands results grid -->
  <div class="mx-auto w-full max-w-[1080px] px-6">
    <div class="pr-head text-center" data-reveal>
      <h2 class="text-[clamp(30px,3.6vw,52px)] font-semibold leading-[1.05] tracking-[-0.04em] text-text">
        A sample of recent results<br class="hidden md:block" /> for our partners.
      </h2>
    </div>

    <p class="intro" data-reveal>We work with a small number of partners at a time: proven founders scaling from 7 to 8 figures, and exceptional experts with an audience to monetise and a clear path to 7 figures.</p>

    <p class="ticker" data-reveal>We launch and scale <span class="rot-slot" aria-live="polite">{rotating.map((w, i) => <span class={`rot-word accent${i === 0 ? " on" : ""}`}>{w}</span>)}</span></p>

  <!-- Row lives inside the same 1080px container as the text, so card edges line up with it.
       Infinite carousel: the script adds copies of the cards on both sides and slides one card every 1.5s. -->
  <div class="viewport" tabindex="0" aria-label="Partner results" aria-roledescription="carousel">
  <ul class="track">
    {partners.map((p, i) => (
      <li class="card" style={`--d:${i * 110}ms`}>
        <div class="media">
          <img class="photo" src={url(p.img)} alt={p.name} loading="lazy" decoding="async" draggable="false" style={`object-position:${p.pos}`} />
        </div>
        <div class="body">
          <h3 class="who">{p.name}</h3>
          <p class="niche">{p.niche}</p>
          {p.bio && <p class="bio">{p.bio}</p>}
          <p class="result">{p.headline}. {p.line}</p>
          <div class="stats">
            {p.stats.map((s) => (
              <div>
                <p class="sv" aria-label={s.v}>
                  <span aria-hidden="true">{parts(s.v).map((x) => ("n" in x ? <span class="count" data-n={x.n} data-dec={x.dec}>{x.t}</span> : x.t))}</span>
                </p>
                <p class="sl">{s.l}</p>
              </div>
            ))}
          </div>
        </div>
      </li>
    ))}
  </ul>
  </div>

  <!-- ‹ • • › under the row: arrows step one card, one dot per partner -->
  <div class="pager">
    <button class="arrow" data-dir="-1" aria-label="Previous partner"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg></button>
    <div class="dots" role="tablist" aria-label="Partner position"></div>
    <button class="arrow" data-dir="1" aria-label="Next partner"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg></button>
  </div>
  </div>
</section>

<style>
  .pr { padding: clamp(96px, 14vh, 160px) 0 clamp(80px, 12vh, 140px); }

  .intro { max-width: 560px; margin: clamp(28px, 4vh, 40px) auto 0; text-align: center; font-size: 15px; line-height: 1.6; color: var(--text-2); }

  /* Rotating line: the words stack in one slot whose width eases to the current word, so the centred line re-centres smoothly.
     The slot is tall enough for descenders and nudged down so the word sits on the sentence's baseline. */
  .ticker { margin: 18px auto 0; text-align: center; font-size: clamp(15px, 1.3vw, 18px); color: var(--text-2); }
  .rot-slot { position: relative; display: inline-block; height: 1.6em; vertical-align: -0.42em; overflow: hidden; text-align: left; transition: width .5s var(--ease-out-soft); }
  .rot-word {
    position: absolute; left: 0; top: 0; white-space: nowrap; color: var(--text); font-size: 1.15em; line-height: 1.35;
    opacity: 0; transform: translateY(100%); transition: transform .5s var(--ease-out-soft), opacity .5s;
  }
  .rot-word.on { opacity: 1; transform: none; }
  .rot-word.out { opacity: 0; transform: translateY(-100%); }

  /* Pager under the row: ‹ dots › */
  .pager { margin-top: 28px; display: flex; align-items: center; justify-content: center; gap: 18px; }
  .dots { display: flex; align-items: center; gap: 8px; }
  /* dots are created by the script, so they need :global (scoped styles only reach elements in the markup) */
  .dots :global(.dot) { width: 8px; height: 8px; padding: 0; border-radius: 99px; background: var(--line); cursor: pointer; transition: width .35s var(--ease-out-soft), background-color .3s; }
  .dots :global(.dot:hover) { background: var(--muted); }
  .dots :global(.dot.on) { width: 24px; background: var(--accent); }
  .arrow {
    width: 44px; height: 44px; display: grid; place-items: center; border-radius: 999px; cursor: pointer;
    color: var(--text); border: 1px solid var(--line); background: color-mix(in srgb, var(--surface) 80%, transparent);
    transition: border-color .2s, background-color .2s, opacity .2s, transform .2s var(--ease-out-soft);
  }
  .arrow svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .arrow:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .arrow:active { transform: scale(.94); }

  /* Viewport clips a sliding row: exactly 3 cards edge to edge in the 1080px column (like LeverBrands).
     Vertical padding gives the cards room; touch keeps vertical page scrolling, horizontal drags move the row. */
  .viewport { margin-top: 28px; padding: 8px 0 16px; overflow: hidden; cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .viewport.dragging { cursor: grabbing; }
  .viewport:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 12px; }
  .track { display: flex; align-items: stretch; gap: 20px; will-change: transform; }
  .track img { -webkit-user-drag: none; user-drag: none; }
  /* while dragging, cards don't react to hover */
  .viewport.dragging .card { pointer-events: none; }

  /* Card: LeverBrands spec — 331px wide (3 per 1080 row, 20px gaps), 12px radius, hairline border, no padding/shadow */
  .card {
    position: relative; flex: 0 0 calc((100% - 40px) / 3);
    display: flex; flex-direction: column; border-radius: 12px; overflow: hidden;
    border: .8px solid var(--line); background: var(--surface);
    /* simple reveal: fade up, staggered by --d */
    transition: opacity .7s var(--ease-out-soft) var(--d), translate .7s var(--ease-out-soft) var(--d), border-color .3s;
  }
  :global(.reveal-ready) .card { opacity: 0; translate: 0 24px; }
  :global(.reveal-ready) .viewport.in .card { opacity: 1; translate: 0 0; }
  .card:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }

  /* Media: 3:2 photo (329x219 at desktop), cover-cropped; no photo animation */
  .media { position: relative; aspect-ratio: 3 / 2; overflow: hidden; isolation: isolate; background: var(--raised); }
  .photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* light grade only (the photo ends in a clean edge like LeverBrands): soft top shade for the chip, faint grain */
  .media::before { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(180deg, rgb(0 0 0 / .28), transparent 35%); }
  .media::after { content: ""; position: absolute; inset: 0; z-index: 1; background-image: var(--noise); background-size: 180px; opacity: .15; mix-blend-mode: overlay; pointer-events: none; }
  /* Body: LeverBrands rhythm — 28px padding, then name, niche, one-line bio, result, stats (+18) */
  .body { display: flex; flex-direction: column; flex: 1; padding: 28px; }
  /* Tom's review: under the name, their niche (not the product), then a one-line bio */
  .who { font-size: 20px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; color: var(--text); }
  .niche { margin-top: 6px; font-size: 13px; font-weight: 600; color: var(--accent); }
  .bio { margin-top: 10px; font-size: 14px; line-height: 21px; color: var(--muted); }
  .result { margin-top: 14px; font-size: 15px; line-height: 23px; color: var(--text-2); }
  /* cards share the tallest height; stats sit on the bottom edge so they line up across the row */
  .stats { display: flex; gap: 32px; margin-top: auto; padding-top: 18px; }
  .stats > div { min-width: 0; }
  .sv { font-size: 22px; font-weight: 800; letter-spacing: -0.02em; line-height: 29px; color: var(--accent); font-variant-numeric: tabular-nums; }
  .sl { margin-top: 4px; font-size: 10px; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); }

  @media (min-width: 768px) and (max-width: 1023px) { .card { flex-basis: calc((100% - 20px) / 2); } }
  @media (max-width: 767px) {
    .card { flex-basis: 86%; }
  }
</style>

<script>
  const sec = document.getElementById("results")!;
  // Rotating word: a new one every 2.2s (skipped while the tab is hidden)
  const slot = sec.querySelector<HTMLElement>(".rot-slot")!;
  const words = [...slot.querySelectorAll<HTMLElement>(".rot-word")];
  let w = 0;
  const fit = () => (slot.style.width = `${words[w].offsetWidth}px`);
  fit();
  addEventListener("resize", fit);
  document.fonts?.ready.then(fit);
  setInterval(() => {
    if (document.hidden) return;
    const prev = words[w];
    w = (w + 1) % words.length;
    prev.classList.remove("on"); prev.classList.add("out");
    words[w].classList.remove("out"); words[w].classList.add("on");
    setTimeout(() => prev.classList.remove("out"), 520);
    fit();
  }, 2200);

  const viewport = sec.querySelector<HTMLElement>(".viewport")!;
  const track = sec.querySelector<HTMLElement>(".track")!;
  const real = [...track.querySelectorAll<HTMLElement>(".card")];
  const n = real.length;

  // Infinite loop: a full set of copies before and after the real cards. The row sits on the real set; whenever a
  // slide lands on a copy, it jumps (without animating) to the matching real card, so it never runs out.
  const copy = (c: HTMLElement) => {
    const el = c.cloneNode(true) as HTMLElement;
    el.setAttribute("aria-hidden", "true");
    el.querySelectorAll("img").forEach((i) => (i.loading = "eager"));
    return el;
  };
  real.slice().reverse().forEach((c) => track.prepend(copy(c)));
  real.forEach((c) => track.append(copy(c)));
  const all = [...track.querySelectorAll<HTMLElement>(".card")];

  // Reveal: cards fade up (CSS), then the stat numbers count up (copies too, so they match when they slide in)
  const countUp = (el: HTMLElement, delay: number) => {
    const to = parseFloat(el.dataset.n!), dec = parseInt(el.dataset.dec!), dur = 1500;
    el.textContent = (0).toFixed(dec);
    setTimeout(() => {
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
        el.textContent = (to * e).toFixed(dec);
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, delay);
  };
  let visible = false;
  const io = new IntersectionObserver(([en]) => {
    visible = en.isIntersecting;
    if (!visible || viewport.classList.contains("in")) return;
    viewport.classList.add("in");
    all.forEach((c, i) => c.querySelectorAll<HTMLElement>(".count").forEach((el) => countUp(el, (i % n) * 110 + 350)));
  }, { threshold: 0.2 });
  io.observe(viewport);

  // Position: index = first card in view (n = first real card); offset = live drag distance
  const SLIDE = 600, EVERY = 1500;
  let index = n, offset = 0;
  const step = () => real[0].offsetWidth + 20; // card + gap
  const dotsBox = sec.querySelector<HTMLElement>(".dots")!;
  const dots: HTMLButtonElement[] = [];
  const place = (animate: boolean) => {
    track.style.transition = animate ? `transform ${SLIDE}ms cubic-bezier(.22, .8, .3, 1)` : "none";
    track.style.transform = `translateX(${-index * step() + offset}px)`;
    const at = ((index % n) + n) % n;
    dots.forEach((d, k) => { d.classList.toggle("on", k === at); d.setAttribute("aria-selected", String(k === at)); });
  };
  track.addEventListener("transitionend", (e) => {
    if (e.target !== track) return;
    if (index >= 2 * n) index -= n;
    else if (index < n) index += n;
    place(false);
  });
  const go = (to: number) => { index = to; place(true); };

  // Autoplay: one card every 1.5s while the row is on screen; pauses on hover, keyboard focus and drag
  let hover = false, dragging = false, timer = 0;
  const tick = () => { if (visible && !hover && !dragging && !document.hidden) go(index + 1); };
  const restart = () => { clearInterval(timer); timer = window.setInterval(tick, EVERY); };

  // Arrows and one dot per partner
  real.forEach((_, k) => {
    const d = document.createElement("button");
    d.className = "dot"; d.setAttribute("role", "tab"); d.setAttribute("aria-label", `Show partner ${k + 1}`);
    d.addEventListener("click", () => { go(n + k); restart(); });
    dotsBox.appendChild(d);
    dots.push(d);
  });
  sec.querySelectorAll<HTMLButtonElement>(".arrow").forEach((b) => b.addEventListener("click", () => { go(index + Number(b.dataset.dir)); restart(); }));
  viewport.addEventListener("mouseenter", () => (hover = true));
  viewport.addEventListener("mouseleave", () => (hover = false));
  viewport.addEventListener("focusin", () => (hover = true));
  viewport.addEventListener("focusout", () => (hover = false));
  viewport.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
    go(index + (e.key === "ArrowRight" ? 1 : -1));
    restart();
  });

  // Drag (mouse) and swipe (touch): the row follows the pointer, then settles on the nearest card
  let downX = 0, moved = false;
  viewport.addEventListener("dragstart", (e) => e.preventDefault()); // no "ghost" copy of the photo
  viewport.addEventListener("pointerdown", (e) => {
    if (e.pointerType === "mouse" && e.button !== 0) return;
    dragging = true; moved = false; downX = e.clientX; offset = 0;
    viewport.classList.add("dragging");
    viewport.setPointerCapture(e.pointerId);
    place(false);
  });
  viewport.addEventListener("pointermove", (e) => {
    if (!dragging) return;
    offset = e.clientX - downX;
    if (Math.abs(offset) > 4) moved = true;
    place(false);
  });
  const end = () => {
    if (!dragging) return;
    dragging = false;
    viewport.classList.remove("dragging");
    const by = Math.round(-offset / step());
    offset = 0;
    go(index + by);
    restart();
  };
  viewport.addEventListener("pointerup", end);
  viewport.addEventListener("pointercancel", end);
  // a drag shouldn't also count as a click inside a card
  viewport.addEventListener("click", (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);

  addEventListener("resize", () => place(false));
  place(false);
  restart();
</script>
