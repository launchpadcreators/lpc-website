---
// Partners and results, modelled on the LeverBrands "The results" cards Tom pointed to in the brief:
// same size, layout and type scale (3:2 photo, result sentence, name, two stats). No video/testimonial slot for now.
// The result sentence is the headline result + supporting line; stat figures come from that copy.
// Copy is word for word from brief/04-copy-deck.md, section 4 (every figure needs partner sign-off before launch).
// Cards sit in a horizontal row you can swipe / drag / step through with arrows.
// Motion: cards glide in from a blur, photos wipe up and settle, the stat numbers count up,
// hover tilts the card with a cursor spotlight and brings the photo to full colour.
const rotating = ["course", "community", "cohort", "digital product", "SaaS"];
import { url } from "../config/paths";
// Partner photos live in public/partners/ (white-background shots are cut out onto the dark warm backdrop).
const partners = [
  {
    name: "Nicolas Boucher", business: "AI Finance Club", img: "/partners/nicolas-boucher.jpg", pos: "50% 50%",
    headline: "$50K → $650K a month", line: "In around 9 months.", // [CONFIRM sign-off: ex-partner]
    stats: [{ v: "$650K", l: "A month" }, { v: "9", l: "Months" }],
  },
  {
    name: "Joseph McClendon III", business: "Vital AF", img: "/partners/joseph-mcclendon.jpg", pos: "50% 22%",
    headline: "16x ROAS on launch", line: "From zero to launch in 2 months.",
    stats: [{ v: "16x", l: "ROAS on launch" }, { v: "2", l: "Months to launch" }],
  },
  {
    name: "Chris Donnelly", business: "The Creator Accelerator", img: "/partners/chris-donnelly.jpg", pos: "50% 50%",
    headline: "6.5x ROAS on the first cohort", line: "Then full ownership of marketing, sales and product.",
    stats: [{ v: "6.5x", l: "ROAS, first cohort" }],
  },
  {
    name: "Jo Bird", business: "Personal branding programme", img: "/partners/jo-bird.jpg", pos: "50% 50%",
    headline: "$30K first launch, $0 ad spend", line: "Her first launch with us.", // [CONFIRM public figure]
    stats: [{ v: "$30K", l: "First launch" }, { v: "$0", l: "Ad spend" }],
  },
];
// Split a headline into text and number parts so the numbers can count up ("$50K → $650K" → "$", 50, "K → $", 650, "K")
const parts = (s: string) => s.split(/(\d+(?:\.\d+)?)/).map((t, i) => (i % 2 ? { n: +t, dec: (t.split(".")[1] ?? "").length, t } : { t }));
---
<section id="results" class="pr relative" aria-label="Partners and results">
  <!-- 1080px container with 24px gutters, same as the LeverBrands results grid -->
  <div class="mx-auto w-full max-w-[1080px] px-6">
    <div class="pr-head text-center" data-reveal>
      <h2 class="text-[clamp(30px,3.6vw,52px)] font-semibold leading-[1.05] tracking-[-0.04em] text-text">
        A sample of recent results<br class="hidden md:block" /> for our partners.
      </h2>
      <p class="rot mt-5 text-[clamp(17px,1.6vw,22px)] text-text-2">
        We launch and scale a{" "}
        <span class="rot-slot" aria-live="polite">
          {rotating.map((w, i) => <span class={`rot-word accent${i === 0 ? " on" : ""}`}>{w}</span>)}
        </span>
      </p>
    </div>

    <div class="pr-bar">
      <p class="intro">We work with a small number of partners at a time: proven founders scaling from 7 to 8 figures, and exceptional experts with an audience to monetise and a clear path to 7 figures.</p>
      <div class="arrows">
        <button class="arrow" data-dir="-1" aria-label="Previous partner"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg></button>
        <button class="arrow" data-dir="1" aria-label="Next partner"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg></button>
      </div>
    </div>

  <!-- Row lives inside the same container as the intro + arrows, so card edges line up with the text above -->
  <ul class="track" tabindex="0" aria-label="Partner results">
    {partners.map((p, i) => (
      <li class="card" style={`--d:${i * 110}ms`}>
        <div class="media">
          <img class="photo" src={url(p.img)} alt={p.name} loading="lazy" decoding="async" draggable="false" style={`object-position:${p.pos}`} />
          <span class="biz">{p.business}</span>
        </div>
        <div class="body">
          <h3 class="who">{p.name}</h3>
          <p class="result">{p.headline}. {p.line}</p>
          <div class="stats">
            {p.stats.map((s) => (
              <div>
                <p class="sv" aria-label={s.v}>
                  <span aria-hidden="true">{parts(s.v).map((x) => ("n" in x ? <span class="count" data-n={x.n} data-dec={x.dec}>{x.t}</span> : x.t))}</span>
                </p>
                <p class="sl">{s.l}</p>
              </div>
            ))}
          </div>
        </div>
      </li>
    ))}
  </ul>
  </div>
</section>

<style>
  .pr { padding: clamp(96px, 14vh, 160px) 0 clamp(80px, 12vh, 140px); }

  /* Rotating word: words stack in one slot; the slot's width eases to the current word */
  /* slot is tall enough for descenders (the "y" in community), nudged down so the word sits on the sentence baseline */
  .rot-slot { position: relative; display: inline-block; height: 1.6em; vertical-align: -0.42em; overflow: hidden; transition: width .5s var(--ease-out-soft); }
  .rot-word {
    position: absolute; left: 0; top: 0; white-space: nowrap; color: var(--text); font-size: 1.15em; line-height: 1.35;
    opacity: 0; transform: translateY(100%); transition: transform .5s var(--ease-out-soft), opacity .5s;
  }
  .rot-word.on { opacity: 1; transform: none; }
  .rot-word.out { opacity: 0; transform: translateY(-100%); }

  .pr-bar { margin-top: clamp(40px, 6vh, 64px); display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .intro { max-width: 520px; font-size: 15px; line-height: 1.55; color: var(--text-2); }
  .arrows { display: flex; gap: 10px; flex-shrink: 0; }
  .arrow {
    width: 44px; height: 44px; display: grid; place-items: center; border-radius: 999px; cursor: pointer;
    color: var(--text); border: 1px solid var(--line); background: color-mix(in srgb, var(--surface) 80%, transparent);
    transition: border-color .2s, background-color .2s, opacity .2s, transform .2s var(--ease-out-soft);
  }
  .arrow svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .arrow:hover:not(:disabled) { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .arrow:active:not(:disabled) { transform: scale(.94); }
  .arrow:disabled { opacity: .3; cursor: default; }

  /* Track: contained in the 1080px column — exactly 3 cards edge to edge (like LeverBrands), arrows bring in the 4th.
     Vertical padding gives the hover lift room (a horizontal scroller clips on both axes). */
  .track {
    display: flex; align-items: stretch; gap: 20px; margin-top: 28px; padding: 8px 0 16px;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; cursor: grab;
  }
  .track::-webkit-scrollbar { display: none; }
  .track { user-select: none; -webkit-user-select: none; }
  .track img { -webkit-user-drag: none; user-drag: none; }
  .track.dragging { cursor: grabbing; scroll-snap-type: none; }
  /* while dragging, cards don't react to hover (no lift / photo zoom mid-drag) */
  .track.dragging .card { pointer-events: none; }
  .track:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  /* Card: LeverBrands spec — 331px wide (3 per 1080 row, 20px gaps), 12px radius, hairline border, no padding/shadow */
  .card {
    position: relative; flex: 0 0 calc((100% - 40px) / 3); scroll-snap-align: start;
    display: flex; flex-direction: column; border-radius: 12px; overflow: hidden;
    border: .8px solid var(--line); background: var(--surface);
    /* reveal uses translate / opacity / filter (staggered by --d); hover tilt uses transform, so it never inherits the delay */
    transition:
      translate 1s var(--ease-out-soft) var(--d), opacity 1s var(--ease-out-soft) var(--d), filter 1s var(--ease-out-soft) var(--d),
      transform .5s var(--ease-out-soft), border-color .3s;
  }
  :global(.reveal-ready) .card { opacity: 0; translate: 90px 0; filter: blur(10px); }
  :global(.reveal-ready) .track.in .card { opacity: 1; translate: 0 0; filter: none; }
  .card.tilting { transition: translate 1s var(--ease-out-soft) var(--d), opacity 1s var(--ease-out-soft) var(--d), filter 1s var(--ease-out-soft) var(--d), transform .12s linear, border-color .3s; }
  .card:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  /* Cursor spotlight */
  .card::after {
    content: ""; position: absolute; inset: 0; z-index: 2; pointer-events: none; border-radius: inherit; opacity: 0; transition: opacity .35s;
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), rgb(255 140 60 / .12), transparent 60%);
  }
  .card:hover::after { opacity: 1; }

  /* Media: 3:2 photo (329x219 at desktop), cover-cropped at 50% 22%; slow zoom + full colour on hover */
  .media { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: var(--raised); }
  .photo {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: saturate(.85); scale: 1.02;
    transition: scale 1.2s var(--ease-out-soft), filter .6s var(--ease-out-soft), clip-path 1.3s var(--ease-out-soft) calc(var(--d) + .15s), translate 1.3s var(--ease-out-soft) calc(var(--d) + .15s);
  }
  /* reveal: the photo wipes up from the bottom and settles down from a slight zoom */
  :global(.reveal-ready) .photo { clip-path: inset(100% 0 0 0); translate: 0 12%; }
  :global(.reveal-ready) .track.in .photo { clip-path: inset(0 0 0 0); translate: 0 0; }
  .card:hover .photo { scale: 1.06; filter: saturate(1); }
  /* light grade only (the photo ends in a clean edge like LeverBrands): soft top shade for the chip, faint grain */
  .media::before { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(180deg, rgb(0 0 0 / .28), transparent 35%); }
  .media::after { content: ""; position: absolute; inset: 0; z-index: 1; background-image: var(--noise); background-size: 180px; opacity: .15; mix-blend-mode: overlay; pointer-events: none; }
  .biz {
    position: absolute; left: 16px; top: 16px; z-index: 2; padding: 6px 10px; border-radius: 999px;
    font-size: 12px; font-weight: 600; color: var(--text); background: rgb(0 0 0 / .35); border: 1px solid rgb(255 255 255 / .12); backdrop-filter: blur(6px);
  }
  /* Body: LeverBrands rhythm — 28px padding, then name, result, stats (+18) */
  .body { display: flex; flex-direction: column; flex: 1; padding: 28px; }
  /* Partner name is the heading (business is on the photo chip); the result is the description under it */
  .who { font-size: 20px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; color: var(--text); }
  .result { margin-top: 8px; font-size: 15px; line-height: 23px; color: var(--text-2); }
  /* cards share the tallest height; stats sit on the bottom edge so they line up across the row */
  .stats { display: flex; gap: 32px; margin-top: auto; padding-top: 18px; }
  .stats > div { min-width: 0; }
  .sv { font-size: 22px; font-weight: 800; letter-spacing: -0.02em; line-height: 29px; color: var(--accent); font-variant-numeric: tabular-nums; }
  .sl { margin-top: 4px; font-size: 10px; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); }

  @media (min-width: 768px) and (max-width: 1023px) { .card { flex-basis: calc((100% - 20px) / 2); } }
  @media (max-width: 767px) {
    .pr-bar { flex-direction: column; align-items: flex-start; }
    .arrows { display: none; }
    .card { flex-basis: 86%; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.reveal-ready) .card { opacity: 1; translate: none; filter: none; }
    :global(.reveal-ready) .photo { clip-path: none; translate: none; }
  }
</style>

<script>
  const sec = document.getElementById("results")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;

  // Rotating word ("course / community / ...")
  const slot = sec.querySelector<HTMLElement>(".rot-slot")!;
  const words = [...slot.querySelectorAll<HTMLElement>(".rot-word")];
  let w = 0;
  const fit = () => (slot.style.width = `${words[w].offsetWidth}px`);
  fit();
  addEventListener("resize", fit);
  if (!reduce) {
    setInterval(() => {
      if (document.hidden) return;
      const prev = words[w];
      w = (w + 1) % words.length;
      prev.classList.remove("on"); prev.classList.add("out");
      words[w].classList.remove("out"); words[w].classList.add("on");
      setTimeout(() => prev.classList.remove("out"), 520);
      fit();
    }, 2200);
  }

  const track = sec.querySelector<HTMLElement>(".track")!;
  const cards = [...track.querySelectorAll<HTMLElement>(".card")];

  // Reveal: cards glide in and photos wipe up (CSS), then the numbers in each card's headline count up
  const countUp = (el: HTMLElement, delay: number) => {
    const to = parseFloat(el.dataset.n!), dec = parseInt(el.dataset.dec!), dur = 1500;
    el.textContent = (0).toFixed(dec);
    setTimeout(() => {
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
        el.textContent = (to * e).toFixed(dec);
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, delay);
  };
  const io = new IntersectionObserver(([en]) => {
    if (!en.isIntersecting) return;
    io.disconnect();
    track.classList.add("in");
    if (!reduce) cards.forEach((c, i) => c.querySelectorAll<HTMLElement>(".count").forEach((el) => countUp(el, i * 110 + 350)));
  }, { threshold: 0.2 });
  io.observe(track);

  // Hover: gentle 3D tilt towards the cursor + spotlight (mouse / trackpad only)
  if (fine && !reduce) {
    cards.forEach((c) => {
      c.addEventListener("pointermove", (e) => {
        if (track.classList.contains("dragging")) return;
        const r = c.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
        c.classList.add("tilting");
        c.style.setProperty("--mx", `${x * 100}%`);
        c.style.setProperty("--my", `${y * 100}%`);
        c.style.transform = `perspective(900px) rotateX(${(0.5 - y) * 5}deg) rotateY(${(x - 0.5) * 6}deg) translateY(-4px)`;
      });
      c.addEventListener("pointerleave", () => { c.classList.remove("tilting"); c.style.transform = ""; });
    });
  }

  // Card row: arrows step one card, mouse can drag, arrows disable at the ends
  const arrows = [...sec.querySelectorAll<HTMLButtonElement>(".arrow")];
  const step = () => (cards[0]?.offsetWidth ?? 331) + 20; // card + gap
  const sync = () => {
    arrows[0].disabled = track.scrollLeft <= 4;
    arrows[1].disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
  };
  arrows.forEach((b) => b.addEventListener("click", () => track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: reduce ? "auto" : "smooth" })));
  track.addEventListener("scroll", sync, { passive: true });
  addEventListener("resize", sync);
  sync();

  let downX = 0, startLeft = 0, moved = false;
  // no native image/text drag (it pulled a "ghost" copy of the photo out of the card)
  track.addEventListener("dragstart", (e) => e.preventDefault());
  track.addEventListener("pointerdown", (e) => {
    if (e.pointerType !== "mouse" || e.button !== 0) return; // touch already swipes natively
    e.preventDefault(); // no text selection while dragging
    downX = e.clientX; startLeft = track.scrollLeft; moved = false;
    track.classList.add("dragging");
    track.setPointerCapture(e.pointerId);
    // drop any hover tilt so the card doesn't twist while the row moves
    cards.forEach((c) => { c.classList.remove("tilting"); c.style.transform = ""; });
  });
  track.addEventListener("pointermove", (e) => {
    if (!track.classList.contains("dragging")) return;
    const dx = e.clientX - downX;
    if (Math.abs(dx) > 4) moved = true;
    track.scrollLeft = startLeft - dx;
  });
  const end = () => {
    if (!track.classList.contains("dragging")) return;
    track.classList.remove("dragging");
    const s = step(); // settle on the nearest card
    track.scrollTo({ left: Math.round(track.scrollLeft / s) * s, behavior: "smooth" });
  };
  track.addEventListener("pointerup", end);
  track.addEventListener("pointercancel", end);
  // a drag shouldn't also count as a click on a link inside a card
  track.addEventListener("click", (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
</script>
