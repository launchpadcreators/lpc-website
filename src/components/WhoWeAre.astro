---
// Who we are — headline, then a grid: the "Our story" card (tall, left), the two co-founder cards with their own
// photos, and the 12-strong team card underneath them (Tom, review 2). Copy: brief/04-copy-deck.md, section 7.
// Founder facts are still marked [CONFIRM] in the copy deck.
import { url } from "../config/paths";
// Same order as the founders photo: Tom (left), Dan (right).
// LinkedIn URLs are the ones linked from launchpadcreators.com ("DM us directly", per Tom's review).
const liIcon = "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z";
const founders = [
  {
    name: "Tom Pestridge", area: "f-a", photo: "team/tom.jpg", linkedin: "https://www.linkedin.com/in/tom-pestridge/",
    line: "Marketing leader and agency founder. Took a travel company to £7M a year as its growth partner.", // [CONFIRM: "£500K to £7M" or "£0 to £7M"]
    stats: [{ v: "£7M", l: "A year, as growth partner" }, { v: "~200K", l: "LinkedIn followers" }],
  },
  {
    name: "Dan Mian", area: "f-b", photo: "team/dan.jpg", linkedin: "https://www.linkedin.com/in/danmian/",
    line: "Performance marketer (Forbes, BT). Founded Gradvance and grew it to $500K.", // [CONFIRM]
    stats: [{ v: "200K+", l: "LinkedIn followers" }, { v: "$500K", l: "Grew Gradvance to" }],
  },
];
const specialisms = ["Paid media", "Creative", "Content", "Funnels and AI", "Sales", "Customer success"];
---
<section id="about" class="wa relative" aria-label="Who we are">
  <div class="mx-auto w-full max-w-[1080px] px-6">
    <div class="text-center" data-reveal>
      <h2 class="text-[clamp(30px,3.6vw,52px)] font-semibold leading-[1.05] tracking-[-0.04em] text-text">
        Full-fledged <em class="accent">growth partners.</em>
      </h2>
    </div>

    <div class="grid3">
      <!-- Our story. [PLACEHOLDER until Tom sends the story: how we started the company and what we believe in.
           For now: the origin story from copy deck 7 plus the 12-strong team line from the video brief.] -->
      <article class="card story" style="--d:0ms">
        <p class="kicker">Our story</p>
        <div class="story-txt">
          <p>We've built and scaled our own businesses, and run growth for others. Doing both, we kept learning the same thing: you can't fix growth with one channel. Ads alone, sales alone or organic alone all hit the same ceiling.</p>
          <p>It takes the whole funnel working as one system. So we built the Launchpad Growth System, then started Launchpad to run it for our partners, with a 12-strong team behind it.</p>
        </div>
        <p class="story-end">We run their growth like it's our own.</p>
      </article>

      {founders.map((f, i) => (
        <article class={`card founder ${f.area}`} style={`--d:${(i + 1) * 110}ms`}>
          <div class="fphoto"><img src={url(f.photo)} alt={f.name} width="540" height="405" loading="lazy" decoding="async" draggable="false" /></div>
          <p class="kicker">Co-founder</p>
          <h3 class="fname">{f.name}</h3>
          <p class="desc">{f.line}</p>
          <div class="stats">
            {f.stats.map((s) => <div><p class="sv">{s.v}</p><p class="sl">{s.l}</p></div>)}
          </div>
          <a class="li" href={f.linkedin} target="_blank" rel="noopener" aria-label={`Message ${f.name} on LinkedIn`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={liIcon} /></svg>
            Message on LinkedIn <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}

      <!-- The team -->
      <article class="card team" style="--d:330ms">
        <div class="team-num">
          <p class="kicker">The team</p>
          <p class="big"><span class="count" data-n="12">12</span></p>
        </div>
        <div class="team-txt">
          <p class="desc">A 12-strong team of specialists across paid media, creative, content, funnels and AI, sales and customer success.</p>
          <ul class="spec">{specialisms.map((s) => <li>{s}</li>)}</ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .wa { padding: clamp(96px, 14vh, 160px) 0; }

  /* Story card spans both rows on the left; founders sit side by side; team card runs underneath them */
  .grid3 {
    margin-top: clamp(40px, 6vh, 64px); display: grid; gap: 20px;
    grid-template-columns: 0.95fr 1fr 1fr;
    grid-template-areas: "story fa fb" "story team team";
  }
  .story { grid-area: story; }
  .f-a { grid-area: fa; }
  .f-b { grid-area: fb; }
  .team { grid-area: team; }
  .card {
    position: relative; overflow: hidden; isolation: isolate; display: flex; flex-direction: column; padding: 28px; border-radius: 16px;
    background: var(--surface); border: 1px solid var(--line);
    transition: translate .8s var(--ease-out-soft) var(--d), opacity .8s var(--ease-out-soft) var(--d), border-color .3s, transform .4s var(--ease-out-soft);
  }
  :global(.reveal-ready) .card { opacity: 0; translate: 0 24px; }
  :global(.reveal-ready) .grid3.in .card { opacity: 1; translate: 0 0; }
  .card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); }
  .card::after { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: var(--noise); background-size: 180px; opacity: .1; mix-blend-mode: overlay; }
  .team { background: radial-gradient(90% 70% at 0% 100%, rgb(255 61 0 / .2), transparent 65%), var(--surface); flex-direction: row; align-items: flex-start; gap: 28px; }
  .team-num { flex-shrink: 0; }
  .team-txt .desc { margin-top: 0; }
  .team .spec { padding-top: 16px; }

  /* Our story: text card with a warm glow from the top corner; the closing line sits at the bottom */
  .story { padding: clamp(28px, 3vw, 36px); background: radial-gradient(90% 60% at 0% 0%, rgb(255 61 0 / .16), transparent 62%), var(--surface); }
  .story-txt { margin-top: 18px; display: grid; gap: 14px; font-size: clamp(15px, 1.25vw, 17px); line-height: 1.65; color: var(--text-2); }
  .story-end { margin-top: auto; padding-top: 24px; font-size: clamp(19px, 1.7vw, 23px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; color: var(--text); }

  /* Founder photo: full-bleed at the top of the card */
  .fphoto { margin: -28px -28px 22px; aspect-ratio: 4 / 3; overflow: hidden; background: var(--raised); }
  .fphoto img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }

  .kicker { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  .big { margin-top: 14px; font-size: clamp(56px, 6vw, 80px); font-weight: 800; letter-spacing: -0.05em; line-height: .9; color: var(--text); font-variant-numeric: tabular-nums; }
  .fname { margin-top: 14px; font-size: clamp(26px, 2.4vw, 32px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; color: var(--text); }
  .desc { margin-top: 14px; font-size: 15px; line-height: 1.55; color: var(--text-2); }

  .spec { margin-top: auto; padding-top: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 14px; font-size: 13px; color: var(--text); }
  .spec li { display: flex; align-items: center; gap: 8px; }
  .spec li::before { content: ""; width: 6px; height: 6px; border-radius: 2px; background: var(--accent); flex-shrink: 0; }

  .stats { margin-top: auto; padding-top: 20px; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .card .stats { margin-top: 24px; }
  .sv { font-size: 26px; font-weight: 800; letter-spacing: -0.03em; line-height: 1; color: var(--accent); }
  .sl { margin-top: 6px; font-size: 10px; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); }

  /* LinkedIn link under the stats */
  .li { margin-top: 20px; display: inline-flex; align-items: center; gap: 9px; align-self: flex-start; font-size: 14px; font-weight: 600; color: var(--text); transition: color .2s; }
  .li svg { width: 16px; height: 16px; fill: currentColor; color: var(--text-2); transition: color .2s; }
  .li span { transition: transform .2s var(--ease-out-soft); }
  .li:hover, .li:hover svg { color: var(--accent); }
  .li:hover span { transform: translateX(3px); }

  @media (max-width: 1023px) {
    .grid3 { grid-template-columns: 1fr 1fr; grid-template-areas: "story story" "fa fb" "team team"; }
  }
  @media (max-width: 767px) {
    .grid3 { grid-template-columns: 1fr; grid-template-areas: "story" "fa" "fb" "team"; }
    .team { flex-direction: column; gap: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { :global(.reveal-ready) .card { opacity: 1; translate: none; } }
</style>

<script>
  const sec = document.getElementById("about")!;
  const grid = sec.querySelector<HTMLElement>(".grid3")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  new IntersectionObserver(([en], o) => {
    if (!en.isIntersecting) return;
    o.disconnect();
    grid.classList.add("in");
    // count the team size up from 0
    const el = sec.querySelector<HTMLElement>(".count")!;
    if (reduce) return;
    const to = Number(el.dataset.n), t0 = performance.now();
    const tick = (t: number) => { const k = Math.min(1, (t - t0) / 1200); el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(tick); };
    requestAnimationFrame(tick);
  }, { threshold: 0.2 }).observe(grid);
</script>
