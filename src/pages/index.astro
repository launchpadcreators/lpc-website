---
import Base from "../layouts/Base.astro";
import Starfield from "../components/Starfield.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import GlassCeiling from "../components/GlassCeiling.astro";
import GrowthSystem from "../components/GrowthSystem.astro";
import Partners from "../components/Partners.astro";
import WhatWeDo from "../components/WhatWeDo.astro";
import HowWeWork from "../components/HowWeWork.astro";
import WhoWeAre from "../components/WhoWeAre.astro";
import Close from "../components/Close.astro";
import Footer from "../components/Footer.astro";
---
<Base
  title="Launchpad Creators | We build and scale 7 and 8 figure creator businesses"
  description="Growth partners for founders, experts and creators to monetise their audience and expertise, and scale to 7 and 8 figures."
>
  <Starfield />
  <Navbar />
  <main class="relative z-10">
    <Hero />
    <Stats />
    <GlassCeiling />
    <!-- Tom picked this version (Loom, 29 Oct, 2:07). The eclipse and funnel versions stay in components/ in case Dan wants one back. -->
    <GrowthSystem />
    <Partners />
    <WhatWeDo />
    <HowWeWork />
    <WhoWeAre />
    <Close />
  </main>
  <Footer />
</Base>
